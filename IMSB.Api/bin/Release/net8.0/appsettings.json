{
  "ConnectionStrings": {
    "DefaultConnection": "Server=Localhost;Database=IMSBDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "IMSB.Api",
    "Audience": "IMSB.Mobile",
    "SigningKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Bazaar": {
    "TotalStalls": 120
  },
  "Session": {
    "IdleTimeoutMinutes": 30,
    "AbsoluteTimeoutHours": 8,
    "RememberMeDays": 7,
    "WarningSeconds": 120
  },
  "AllowedHosts": "*"
}
