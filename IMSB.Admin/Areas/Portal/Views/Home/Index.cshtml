        new { Id = "jewellery", Name = L["Handmade jewellery"].Value, Icon = "bi-gem", Items = new[] {
            (L["Silver filigree earrings"].Value, L["Kalanjali Mahila SHG, Karimnagar"].Value, "1,450", ""),
