        <div class="row g-4">
            <section class="col-lg-7" aria-labelledby="leaders-title">
                <div class="card h-100 shadow-sm border-0 welcome-card">
                    <div class="card-body p-4">
                        <h2 id="leaders-title" class="h4 section-title mb-4">@L["Our leadership"]</h2>
                        <div class="row g-4">
                            <div class="col-sm-6 d-flex align-items-center gap-3">
                                <img class="leader-photo" src="~/portal/images/leaders/chief-minister.jpg" width="96" height="96" alt="@L["Photograph of Sri. Anumula Revanth Reddy"]" />
                                <div>
                                    <h3 class="h6 fw-semibold mb-1">@L["Sri. Anumula Revanth Reddy"]</h3>
                                    <p class="small text-body-secondary mb-0">@L["Hon’ble Chief Minister of Telangana"]</p>
                                </div>
                            </div>
                            <div class="col-sm-6 d-flex align-items-center gap-3">
                                <img class="leader-photo" src="~/portal/images/leaders/minister-rd.jpg" width="96" height="96" alt="@L["Photograph of Smt. D. Anasuya Seethakka"]" />
                                <div>
                                    <h3 class="h6 fw-semibold mb-1">@L["Smt. D. Anasuya Seethakka"]</h3>
                                    <p class="small text-body-secondary mb-0">@L["Hon’ble Minister of Panchayat Raj, Rural Development, RWS, Women & Child Welfare"]</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section class="col-lg-5" aria-labelledby="overview-title">
                <div class="card h-100 shadow-sm border-0 welcome-card">
                    <div class="card-body p-4">
                        <h2 id="overview-title" class="h4 section-title mb-1">@L["Project overview"]</h2>
                        <p class="small text-body-secondary mb-3">@L["From the IMSB project brief, not live data"]</p>
                        <ul class="list-unstyled mb-0 d-grid gap-3">
                            <li class="d-flex align-items-center gap-3">
                                <i class="bi bi-shop stat-icon" aria-hidden="true"></i>
                                <div><span class="stat-num" data-count="100" data-suffix="+">100+</span> <span class="text-body-secondary">@L["bazaar stalls"]</span></div>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <i class="bi bi-calendar3 stat-icon" aria-hidden="true"></i>
                                <div><span class="stat-num">2024</span> <span class="text-body-secondary">@L["initiative launched"]</span></div>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <i class="bi bi-people stat-icon" aria-hidden="true"></i>
                                <div>
                                    <span class="stat-num" data-count="3">3</span> <span class="text-body-secondary">@L["bazaar experiences"]</span>
                                    <div class="small text-body-secondary">@L["Craft demonstrations, pottery workshops and regional food"]</div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<!-- ===================== ABOUT ===================== -->
<section id="about" class="section bg-paper" aria-labelledby="about-title">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 reveal">
                <p class="kicker">@L["About IMSB"]</p>
                <h2 id="about-title" class="section-title display-6 mb-3">@L["Direct market access for women’s enterprise"]</h2>
                <p>@L["Indira Mahila Shakti Bazaar is a Government of Telangana initiative, launched in December 2024, to promote women’s entrepreneurship and financial independence. It gives women-led Self-Help Groups (SHGs) and artisans direct access to buyers and a place to showcase Telangana’s products and traditions."]</p>
                <a href="#products" class="link-imsb fw-semibold">@L["More about IMSB"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-md-4 reveal">
                        <div class="pillar card h-100 border-0 text-center p-4">
                            <i class="bi bi-person-hearts pillar-icon" aria-hidden="true"></i>
                            <h3 class="h5 mt-3">@L["Women’s enterprise"]</h3>
                            <p class="small text-body-secondary mb-0">@L["Supporting women-led SHGs and artisans."]</p>
                        </div>
                    </div>
                    <div class="col-md-4 reveal">
                        <div class="pillar card h-100 border-0 text-center p-4">
                            <i class="bi bi-diamond pillar-icon" aria-hidden="true"></i>
                            <h3 class="h5 mt-3">@L["Telangana craft"]</h3>
                            <p class="small text-body-secondary mb-0">@L["Showcasing the state’s products and traditions."]</p>
                        </div>
                    </div>
                    <div class="col-md-4 reveal">
                        <div class="pillar card h-100 border-0 text-center p-4">
                            <i class="bi bi-shop-window pillar-icon" aria-hidden="true"></i>
                            <h3 class="h5 mt-3">@L["Direct market access"]</h3>
                            <p class="small text-body-secondary mb-0">@L["Connecting makers directly with buyers."]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== PRODUCTS ===================== -->
<section id="products" class="section" aria-labelledby="find-title">
    <div class="container">
        <div class="text-center mx-auto mb-4 reveal" style="max-width: 40rem;">
            <p class="kicker">@L["What you’ll find"]</p>
            <h2 id="find-title" class="section-title display-6">@L["A rich variety from Telangana"]</h2>
            <p class="lead text-body-secondary">@L["Products made by women-led SHGs and artisans, by category."]</p>
        </div>

        <ul class="nav nav-pills product-tabs justify-content-center flex-wrap gap-2 mb-4" role="tablist" aria-label="@L["Product categories"]">
            @for (var c = 0; c < categories.Length; c++)
            {
                var cat = categories[c];
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(c == 0 ? "active" : "")" id="tab-@cat.Id" data-bs-toggle="pill" data-bs-target="#panel-@cat.Id"
                            type="button" role="tab" aria-controls="panel-@cat.Id" aria-selected="@(c == 0 ? "true" : "false")">
                        <i class="bi @cat.Icon me-1" aria-hidden="true"></i>@cat.Name
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content">
            @for (var c = 0; c < categories.Length; c++)
            {
                var cat = categories[c];
                <div class="tab-pane fade @(c == 0 ? "show active" : "")" id="panel-@cat.Id" role="tabpanel" aria-labelledby="tab-@cat.Id" tabindex="0">
                    <h3 class="visually-hidden" id="@cat.Id">@cat.Name</h3>
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                        @for (var p = 0; p < cat.Items.Length; p++)
                        {
                            var item = cat.Items[p];
                            <div class="col">
                                <div class="card product-card h-100">
                                    <div class="ratio ratio-4x3 img-slot">
                                        <div class="img-placeholder" aria-hidden="true"><i class="bi @cat.Icon"></i></div>
                                        <img src="~/portal/images/products/@(cat.Id)-@(p + 1).jpg" alt="@item.Item4" class="object-fit-cover" loading="lazy" onerror="this.remove()" />
                                    </div>
                                    <div class="card-body">
                                        <h4 class="h6 card-title mb-1">@item.Item1</h4>
                                        <p class="small text-body-secondary mb-2">@item.Item2</p>
                                        <p class="product-price mb-0">&#8377;@item.Item3</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a class="btn btn-outline-imsb btn-lg" href="#products">@L["Explore all products"]</a>
        </div>
    </div>
</section>

<!-- ===================== GALLERY ===================== -->
<section id="gallery" class="section bg-paper" aria-labelledby="gallery-title">
    <div class="container">
        <div class="text-center mb-4 reveal">
            <p class="kicker kicker-green">@L["Gallery"]</p>
            <h2 id="gallery-title" class="section-title display-6">@L["Moments from the bazaar"]</h2>
        </div>
        <div class="gallery-grid">
            @for (var g = 0; g < gallery.Length; g++)
            {
                <a class="gallery-item gallery-item-@(g + 1)" href="~/portal/images/gallery/gallery-@(g + 1).jpg"
                   data-bs-toggle="modal" data-bs-target="#lightbox" data-index="@g" data-caption="@gallery[g]">
                    <img src="~/portal/images/gallery/gallery-@(g + 1).jpg" alt="@gallery[g]" loading="lazy" />
                    <span class="gallery-zoom" aria-hidden="true"><i class="bi bi-arrows-fullscreen"></i></span>
                </a>
            }
        </div>
    </div>

    <div class="modal fade" id="lightbox" tabindex="-1" aria-labelledby="lightbox-caption" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-dark text-white border-0">
                <div class="modal-header border-0 pb-0">
                    <p class="modal-title small mb-0" id="lightbox-caption"></p>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body position-relative text-center">
                    <img class="img-fluid rounded lightbox-img" src="" alt="" />
                    <button type="button" class="btn btn-light rounded-circle lightbox-nav start-0 ms-2" data-lb-prev aria-label="@L["Previous photo"]"><i class="bi bi-chevron-left"></i></button>
                    <button type="button" class="btn btn-light rounded-circle lightbox-nav end-0 me-2" data-lb-next aria-label="@L["Next photo"]"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== EXPERIENCE ===================== -->
<section id="experience" class="section bg-paper pt-0" aria-labelledby="exp-title">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 d-none d-lg-block" aria-hidden="true">
                <div class="story-stage">
                    <img class="story-mandala" src="~/portal/images/decor/mandala-gold.png" alt="" loading="lazy" />
                    <img class="story-potter" src="~/portal/images/decor/potter.png" alt="" loading="lazy" />
                    <span class="story-chip badge rounded-pill"><i class="bi bi-palette me-1"></i><span data-story-chip>@L["Live craft demonstrations"]</span></span>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="reveal mb-4">
                    <p class="kicker">@L["Bazaar Experience"]</p>
                    <h2 id="exp-title" class="section-title display-6">@L["More than shopping"]</h2>
                    <p class="lead text-body-secondary">@L["Alongside the stalls, the bazaar hosts cultural activities."]</p>
                </div>
                <div class="d-grid gap-3">
                    @foreach (var e in experiences)
                    {
                        <article class="story-step card border-0 shadow-sm reveal" data-chip="@e.Item2">
                            <div class="card-body d-flex align-items-center gap-3">
                                <span class="story-icon"><i class="bi @e.Item1" aria-hidden="true"></i></span>
                                <div>
                                    <h3 class="h5 mb-1">@e.Item2</h3>
                                    <p class="mb-0 text-body-secondary">@e.Item3</p>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                <p class="mt-4"><a href="#experience" class="link-imsb fw-semibold">@L["See the bazaar experience"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a></p>
            </div>
        </div>
    </div>
</section>

<!-- ===================== TESTIMONIALS ===================== -->
<section id="testimonials" class="section testimonials-section" aria-labelledby="testimonials-title">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <p class="kicker">@L["Testimonials"]</p>
            <h2 id="testimonials-title" class="section-title display-6">@L["What people say"]</h2>
        </div>
        <div class="row g-4">
            @for (var t = 0; t < testimonials.Length; t++)
            {
                var tm = testimonials[t];
                <div class="col-md-4 reveal">
                    <figure class="card testimonial-card h-100 border-0 shadow-sm text-center p-4 mb-0">
                        <div class="testimonial-photo mx-auto mb-3">
                            <img src="~/portal/images/testimonials/person-@(t + 1).png" alt="" loading="lazy" />
                        </div>
                        <i class="bi bi-quote testimonial-mark" aria-hidden="true"></i>
                        <blockquote class="blockquote fs-6 mb-3"><p>@tm.Item1</p></blockquote>
                        <figcaption class="mt-auto">
                            <span class="fw-semibold d-block">@tm.Item2</span>
                            <span class="small text-body-secondary">@tm.Item3</span>
                        </figcaption>
                    </figure>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===================== VISIT BAND ===================== -->
<section id="visit" class="visit-band" aria-labelledby="visit-title">
    <img class="visit-art" src="~/portal/images/decor/craft-frame.png" alt="" aria-hidden="true" loading="lazy" />
    <img class="visit-photo" src="~/portal/images/hero/visit.jpg" alt="@L["Indira Mahila Shakti Bazaar, Madhapur"]" loading="lazy" onerror="this.remove()" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container position-relative text-white reveal">
        <p class="kicker kicker-light">@L["Visit the bazaar"]</p>
        <h2 id="visit-title" class="display-4 fw-semibold">@L["Madhapur, Hyderabad"]</h2>
        <p class="lead">@L["Adjacent to Shilparamam."]</p>
        <p><i class="bi bi-clock me-2" aria-hidden="true"></i>@L["Open daily, 10:30 am – 8:30 pm · Free entry"]</p>
        <a class="btn btn-imsb btn-lg" href="#visit">@L["Plan your visit"]</a>
    </div>
