@model ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = L["Error"].Value;
}

<h1 class="text-danger">@L["Error."]</h1>
<h2 class="text-danger">@L["An error occurred while processing your request."]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["Request ID:"]</strong> <code>@Model.RequestId</code>
    </p>
}

<p class="mt-4"><a class="btn btn-imsb" asp-controller="Home" asp-action="Index">@L["Back to home"]</a></p>

@* for developers only, in English: never shown to visitors of the deployed site *@
@if (Env.IsDevelopment())
{
    <h3 class="mt-5">Development Mode</h3>
    <p>
        The <strong>Development</strong> environment shows detailed information about the error that occurred.
        It must not be enabled for deployed applications: it can show sensitive information from exceptions to end users.
    </p>
}
