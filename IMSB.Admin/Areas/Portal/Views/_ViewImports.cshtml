@using IMSB.Admin
@using IMSB.Admin.Areas.Portal
@using IMSB.Admin.Areas.Portal.Models
@using IMSB.Models
@using Microsoft.AspNetCore.Mvc.Localization
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
