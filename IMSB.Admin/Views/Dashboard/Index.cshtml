@using IMSB.Admin.Resources
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    // IStringLocalizer<SharedResource> would look for "Resources.Resources.SharedResource" (ResourcesPath + namespace)
    // and silently return the keys; the factory form below resolves Resources/SharedResource.<culture>.resx.
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    ViewData["Title"] = L["OperationsDashboard"].Value;
    var s = (IMSB.Dto.Models.DashboardStats)ViewBag.Stats;
    string Money(decimal v) => "₹" + v.ToString("#,##0.##", CultureInfo.GetCultureInfo("en-IN"));

    // Strings used by dashboard.js (cards, charts, lists, relative times)
    var jsKeys = new[] {
        "Occupied", "Vacant", "DailySales", "SalesAmount", "StaffCount", "AttendancePercent", "Present",
        "VsYesterday", "NoComparison", "OnlyLeft", "NoSalesYet", "NoStallsYet", "NoLowStock", "NoActivity",
        "ModuleNotConnected", "AttendanceNotConnected", "ApplicationsNotConnected",
        "ActSale", "ActSaleDesc", "ActStockAdd", "ActStockReduce", "ActStockCorrection", "ActStockInitial", "ActStockDesc",
        "ActStaffAdded", "ActStaffDesc", "JustNow", "UnitsSold", "Critical", "Moderate", "CategoryMonthSubtitle", "LastNDays",
        "OccupiedPct", "DailySalesOverDays", "Error", "CouldNotReachServer"
    };
    var jsStrings = jsKeys.ToDictionary(k => k, k => L[k].Value);
}

<!-- Page Body -->
<div class="page-body">

  <!-- Page Header -->
  <div class="page-header">
    <div>
      <div class="page-title">@L["OperationsDashboard"]</div>
      <div class="page-subtitle">@L["DashboardSubtitle"] &nbsp;|&nbsp; <span id="dashDate"></span></div>
    </div>
    <div class="page-actions">
      <button type="button" class="btn btn-outline btn-sm" id="dashboardExportBtn">
        <i class="fa-solid fa-download"></i> @L["ExportReport"]
      </button>
      <a class="btn btn-primary btn-sm" href="/Sales/Index" id="newSalesEntryBtn">
        <i class="fa-solid fa-plus"></i> @L["NewSalesEntry"]
      </a>
    </div>
  </div>

  <!-- Alert Banner (hidden when nothing is below its minimum) -->
  <div class="alert alert-warning" id="lowStockBanner" style="margin-bottom:18px;@(s.LowStockItems == 0 ? "display:none" : "")">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <div><strong>@L["LowStockAlertLabel"]</strong> <span id="lowStockBannerText">@string.Format(L["LowStockBanner"].Value, s.LowStockItems)</span>
      <a href="/Inventory" style="color:var(--warning);font-weight:600">@L["ViewInventory"] →</a></div>
  </div>

  <!-- ── STAT CARDS ── -->
  <div class="stat-grid">
    <div class="stat-card blue">
      <div class="stat-icon"><i class="fa-solid fa-store"></i></div>
      <div class="stat-value" id="stat-stalls">@s.TotalStalls</div>
      <div class="stat-label">@L["TotalStalls"]</div>
      <div class="stat-change up"><i class="fa-solid fa-chart-pie"></i> <span id="stat-occ-pct">@string.Format(L["OccupiedPct"].Value, s.OccupancyPct)</span></div>
    </div>
    <div class="stat-card orange">
      <div class="stat-icon"><i class="fa-solid fa-door-open"></i></div>
      <div class="stat-value" id="stat-occupied">@s.OccupiedStalls</div>
      <div class="stat-label">@L["OccupiedStalls"]</div>
      <div class="stat-change up"><i class="fa-solid fa-circle-check"></i> @L["Active"]</div>
    </div>
    <div class="stat-card green">
      <div class="stat-icon"><i class="fa-solid fa-door-closed"></i></div>
      <div class="stat-value" id="stat-vacant">@s.VacantStalls</div>
      <div class="stat-label">@L["VacantStalls"]</div>
      <div class="stat-change up"><i class="fa-solid fa-clock"></i> @L["Available"]</div>
    </div>
    <div class="stat-card indigo">
      <div class="stat-icon"><i class="fa-solid fa-palette"></i></div>
      <div class="stat-value" id="stat-artisans">@(s.TotalArtisans?.ToString() ?? "—")</div>
      <div class="stat-label">@L["TotalArtisans"]</div>
      <div class="stat-change" id="stat-artisans-note"><i class="fa-solid fa-circle-info"></i> @(s.TotalArtisans == null ? L["ModuleNotConnected"].Value : L["Registered"].Value)</div>
    </div>
    <div class="stat-card green">
      <div class="stat-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
      <div class="stat-value" id="stat-sales">@Money(s.TodaySales)</div>
      <div class="stat-label">@L["TodaysSales"]</div>
      <div class="stat-change @(s.SalesChangePct < 0 ? "down" : "up")" id="stat-sales-change">@(s.SalesChangePct == null ? L["NoComparison"].Value : string.Format(L["VsYesterday"].Value, (s.SalesChangePct >= 0 ? "+" : "") + s.SalesChangePct.Value.ToString("0.0", CultureInfo.InvariantCulture) + "%"))</div>
    </div>
    <div class="stat-card red">
      <div class="stat-icon"><i class="fa-solid fa-box-open"></i></div>
      <div class="stat-value" id="stat-lowstock">@s.LowStockItems</div>
      <div class="stat-label">@L["LowStockItems"]</div>
      <div class="stat-change down"><i class="fa-solid fa-triangle-exclamation"></i> @L["NeedsRestock"]</div>
    </div>
    <div class="stat-card orange">
      <div class="stat-icon"><i class="fa-solid fa-file-circle-exclamation"></i></div>
      <div class="stat-value" id="stat-pending">@(s.PendingApplications?.ToString() ?? "—")</div>
      <div class="stat-label">@L["PendingApplications"]</div>
      <div class="stat-change" id="stat-pending-note"><i class="fa-solid fa-clock"></i> @(s.PendingApplications == null ? L["ModuleNotConnected"].Value : L["AwaitingReview"].Value)</div>
    </div>
  </div>

  <!-- ── APPLICATION WIDGETS ── -->
  <div style="margin-bottom:8px;font-size:.8rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px">
    @L["ArtisanApplicationsOverview"]
  </div>
  <div class="app-widget-grid" style="margin-bottom:8px">
    <div class="app-widget green">
      <div class="app-widget-header">
        <span class="app-widget-label">@L["ApprovedLabel"]</span>
        <i class="fa-solid fa-circle-check" style="color:var(--success);font-size:.9rem"></i>
      </div>
      <div class="app-widget-count" id="aw-approved">—</div>
      <div class="app-widget-bar"><div class="app-widget-bar-fill" id="aw-approved-bar" style="width:0%"></div></div>
      <div class="app-widget-sub">@L["ApprovedThisMonth"]</div>
    </div>
    <div class="app-widget amber">
      <div class="app-widget-header">
        <span class="app-widget-label">@L["UnderReviewLabel"]</span>
        <i class="fa-solid fa-magnifying-glass" style="color:var(--warning);font-size:.9rem"></i>
      </div>
      <div class="app-widget-count" id="aw-review">—</div>
      <div class="app-widget-bar"><div class="app-widget-bar-fill" id="aw-review-bar" style="width:0%"></div></div>
      <div class="app-widget-sub">@L["BeingProcessed"]</div>
    </div>
    <div class="app-widget blue">
      <div class="app-widget-header">
        <span class="app-widget-label">@L["ToBeProcessed"]</span>
        <i class="fa-solid fa-inbox" style="color:var(--primary-light);font-size:.9rem"></i>
      </div>
      <div class="app-widget-count" id="aw-pending">—</div>
      <div class="app-widget-bar"><div class="app-widget-bar-fill" id="aw-pending-bar" style="width:0%"></div></div>
      <div class="app-widget-sub">@L["NewlySubmitted"]</div>
    </div>
  </div>
  <div class="dash-note" id="applicationsNote" style="margin-bottom:24px">@L["ApplicationsNotConnected"]</div>

  <!-- ── CHARTS ── -->
  <div class="charts-grid">
    <!-- Sales Trend -->
    <div class="chart-card chart-col-8">
      <div class="chart-header">
        <div>
          <div class="chart-title"><i class="fa-solid fa-chart-line"></i> @L["SalesTrend"]</div>
          <div class="chart-subtitle" id="salesTrendSubtitle">@string.Format(L["DailySalesOverDays"].Value, 40)</div>
        </div>
        <select class="chart-period-select" id="trendPeriod" aria-label="@L["SalesTrend"]">
          <option value="40">@string.Format(L["LastNDays"].Value, 40)</option>
          <option value="90">@L["Last3Months"]</option>
          <option value="180">@L["Last6Months"]</option>
        </select>
      </div>
      <div class="chart-body">
        <div class="chart-canvas-wrap" style="height:240px">
          <canvas id="salesTrendChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Stall Occupancy -->
    <div class="chart-card chart-col-4">
      <div class="chart-header">
        <div>
          <div class="chart-title"><i class="fa-solid fa-store"></i> @L["StallOccupancy"]</div>
          <div class="chart-subtitle">@L["CurrentStatus"]</div>
        </div>
      </div>
      <div class="chart-body">
        <div class="chart-canvas-wrap" style="height:200px">
          <canvas id="stallOccupancyChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Category Sales -->
    <div class="chart-card chart-col-6">
      <div class="chart-header">
        <div>
          <div class="chart-title"><i class="fa-solid fa-chart-bar"></i> @L["CategoryWiseSales"]</div>
          <div class="chart-subtitle" id="categorySubtitle"></div>
        </div>
      </div>
      <div class="chart-body">
        <div class="chart-canvas-wrap" style="height:230px">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Staff Attendance -->
    <div class="chart-card chart-col-6">
      <div class="chart-header">
        <div>
          <div class="chart-title"><i class="fa-solid fa-calendar-check"></i> @L["StaffAttendancePct"]</div>
          <div class="chart-subtitle">@L["CurrentWeek"]</div>
        </div>
      </div>
      <div class="chart-body">
        <div class="chart-canvas-wrap" style="height:230px">
          <canvas id="attendanceChart"></canvas>
          <div class="chart-empty" id="attendanceEmpty" style="display:none"></div>
        </div>
      </div>
    </div>

    <!-- Dept Attendance -->
    <div class="chart-card chart-col-4">
      <div class="chart-header">
        <div>
          <div class="chart-title"><i class="fa-solid fa-people-group"></i> @L["DeptWiseAttendance"]</div>
          <div class="chart-subtitle">@L["ThisWeekAverage"]</div>
        </div>
      </div>
      <div class="chart-body">
        <div class="chart-canvas-wrap" style="height:230px">
          <canvas id="deptAttChart"></canvas>
          <div class="chart-empty" id="deptAttEmpty" style="display:none"></div>
        </div>
      </div>
    </div>

    <!-- Top Stalls -->
    <div class="chart-card chart-col-4">
      <div class="chart-header">
        <div>
          <div class="chart-title"><i class="fa-solid fa-trophy"></i> @L["BestPerformingStalls"]</div>
          <div class="chart-subtitle">@L["ThisMonth"]</div>
        </div>
      </div>
      <div class="chart-body" style="padding-top:8px">
        <div id="topPerformers"></div>
      </div>
    </div>

    <!-- Low Stalls -->
    <div class="chart-card chart-col-4">
      <div class="chart-header">
        <div>
          <div class="chart-title"><i class="fa-solid fa-arrow-trend-down"></i> @L["LowPerformingStalls"]</div>
          <div class="chart-subtitle">@L["ThisMonth"]</div>
        </div>
      </div>
      <div class="chart-body" style="padding-top:8px">
        <div id="lowPerformers"></div>
      </div>
    </div>
  </div>

  <!-- ── BOTTOM ROW ── -->
  <div class="dash-bottom-grid">

    <!-- Low Stock -->
    <div class="card">
      <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-triangle-exclamation" style="color:var(--danger)"></i> @L["LowStockAlerts"]</div>
        <a href="/Inventory" style="font-size:.72rem;color:var(--primary-light);font-weight:600">@L["ViewAll"]</a>
      </div>
      <div class="card-body" style="padding-top:8px">
        <div id="lowStockList"></div>
      </div>
    </div>

    <!-- Activity -->
    <div class="card">
      <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-clock-rotate-left"></i> @L["RecentActivity"]</div>
      </div>
      <div class="card-body" style="padding-top:8px">
        <div class="activity-feed" id="activityFeed"></div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
      <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-bolt"></i> @L["QuickActions"]</div>
      </div>
      <div class="card-body">
        <div class="quick-actions-grid">
          <a class="quick-action-btn" href="/Stalls"><i class="fa-solid fa-store-slash"></i><span>@L["AllocateStall"]</span></a>
          <a class="quick-action-btn" href="/Inventory"><i class="fa-solid fa-plus-circle"></i><span>@L["AddProduct"]</span></a>
          <a class="quick-action-btn" href="/Sales"><i class="fa-solid fa-cash-register"></i><span>@L["EnterSales"]</span></a>
          <a class="quick-action-btn" href="/Artisans"><i class="fa-solid fa-user-plus"></i><span>@L["NewArtisan"]</span></a>
          <a class="quick-action-btn" href="/Attendance"><i class="fa-solid fa-fingerprint"></i><span>@L["Attendance"]</span></a>
          <a class="quick-action-btn" href="/Reports"><i class="fa-solid fa-file-export"></i><span>@L["Reports"]</span></a>
        </div>
      </div>
    </div>

  </div>

</div>

@section Styles {
  <style>
    .dash-bottom-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:18px; }
    .dash-note { font-size:.72rem; color:var(--text-muted); }
    .chart-canvas-wrap { position:relative; }
    .chart-empty { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; text-align:center; padding:12px; font-size:.78rem; color:var(--text-muted); }
    .empty-state { text-align:center; padding:18px 8px; color:var(--text-muted); font-size:.78rem; }
    a.quick-action-btn { text-decoration:none; color:inherit; }
    @@media (max-width: 900px) { .chart-col-8, .chart-col-6, .chart-col-4 { grid-column: span 12; } }
  </style>
}

@section Scripts {
  <script>window.DashboardI18n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jsStrings));</script>
  <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
