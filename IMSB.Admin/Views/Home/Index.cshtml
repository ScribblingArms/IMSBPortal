@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    ViewData["Title"] = L["Home"].Value;
}

<main class="page-body">
    <div class="card" style="max-width:560px;margin:40px auto">
        <div class="card-body" style="text-align:center;padding:32px">
            <div class="page-title">@L["Welcome"]</div>
            <p style="color:var(--text-muted);margin-top:8px">@L["SignInToContinue"]</p>
            <a class="btn btn-primary btn-sm" style="margin-top:16px" href="@Url.Action("Login", "Account")">@L["SignInToPortal"]</a>
        </div>
    </div>
</main>
