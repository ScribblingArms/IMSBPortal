@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    var years = (List<int>)ViewBag.Years;
    var months = (List<KeyValuePair<int, string>>)ViewBag.MonthsOfYear;
    var today = DateTime.Today;
    var jsKeys = new[] { "CouldNotReachServer", "AllDepartments", "NoStaffForAttendance", "SalaryRequestFailed", "SearchSalaryPlaceholder", "GrandTotal" };
    var jsStrings = jsKeys.ToDictionary(key => key, key => L[key].Value);
}
<main class="page-body">
  <div class="page-header"><div><div class="page-title">@L["SalaryReport"]</div></div></div>
  <div class="report-info-banner"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>@L["SalaryProrationNote"]</span></div>
  <div class="card">
    <div class="card-header">
      <div class="card-title"><i class="fa-solid fa-money-check-dollar"></i> @L["SalaryReport"] <span class="tab-count" id="salaryReportCount">0</span></div>
      <button type="button" class="btn btn-outline btn-sm" id="salaryReportExport"><i class="fa-solid fa-file-excel"></i> @L["ExportToExcel"]</button>
    </div>
    <div class="card-body">
      <div class="salary-report-tools">
        <div class="search-box salary-report-search"><i class="fa-solid fa-search"></i><input type="search" id="salaryReportSearch" placeholder="@L["SearchSalaryPlaceholder"]" aria-label="@L["SearchSalaryPlaceholder"]"></div>
        <select class="form-control" id="salaryReportYear" aria-label="@L["Year"]">
          @foreach (var year in years) { <option value="@year" selected="@(year == today.Year)">@year</option> }
        </select>
        <select class="form-control" id="salaryReportMonth" aria-label="@L["Month"]">
          @foreach (var month in months) { <option value="@month.Key" selected="@(month.Key == today.Month)">@month.Value</option> }
        </select>
        <select class="form-control" id="salaryReportType" aria-label="@L["Department"]"><option value="">@L["AllDepartments"]</option></select>
        <button type="button" class="btn btn-outline btn-sm" id="salaryReportSearchBtn"><i class="fa-solid fa-magnifying-glass"></i> @L["Search"]</button>
        <button type="button" class="btn btn-outline btn-sm btn-reset" id="salaryReportClearBtn">@L["Reset"]</button>
      </div>
      <div class="form-error" id="salaryReportError" role="alert"></div>
      <div class="table-container">
        <table class="data-table salary-report-table">
          <thead><tr>
            <th>@L["SerialNumber"]</th><th>@L["EmployeeID"]</th><th>@L["StaffName"]</th>
            <th>@L["EmployeeType"]</th><th>@L["Designation"]</th><th>@L["TotalDaysInMonth"]</th>
            <th>@L["WorkedDays"]</th><th>@L["TotalSalary"]</th>
          </tr></thead>
          <tbody id="salaryReportBody"></tbody>
          <tfoot id="salaryReportFoot"></tfoot>
        </table>
      </div>
    </div>
  </div>
</main>
@section Styles {
  <style>
    .salary-report-tools { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:18px; }
    .salary-report-search { flex:1 1 280px; max-width:420px; }
    .salary-report-tools .form-control { flex:0 1 150px; width:auto; min-width:130px; }
    .salary-report-tools > .btn { min-width:100px; }
    .salary-report-table { min-width:1000px; }
    .salary-report-table th,.salary-report-table td { text-align:center; }
    .salary-report-table th { background:#eff3f9; color:#64748b; font-size:.7rem; letter-spacing:.06em; text-transform:uppercase; }
    .salary-report-table tbody tr { border-bottom:1px solid #d5deeb; }
    .salary-report-table tbody tr:nth-child(even) td { background:#f8f9fb; }
    .salary-report-table tbody tr:hover td { background:#f0f5ff; }
    .salary-report-table tfoot td { background:#eff3f9; border-top:2px solid #d5deeb; font-weight:800; }
    .salary-report-table tfoot .salary-report-total-label { text-align:right; }
    .salary-report-table .salary-report-name { text-align:left; font-weight:700; }
    @@media(max-width:700px) { .salary-report-tools { align-items:stretch; } .salary-report-search { flex:1 1 100%; max-width:none; } .salary-report-tools .form-control,.salary-report-tools > .btn { flex:1 1 130px; } }
  </style>
}
@section Scripts {
  <script>window.ReportsI18n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jsStrings));</script>
  <script src="~/js/reports.js" asp-append-version="true"></script>
}
