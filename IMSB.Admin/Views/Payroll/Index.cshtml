@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    var years = (List<int>)ViewBag.Years;
    var months = (List<KeyValuePair<int, string>>)ViewBag.Months;
}
<main class="page-body">
  <div class="page-header">
    <div>
      <div class="page-title">@L["PayBillTitle"]</div>
      <div class="page-subtitle">@L["PayBillSubtitle"]</div>
    </div>
    <div class="page-actions">
      <button type="button" class="btn btn-outline btn-sm" id="payBillExcel" disabled><i class="fa-solid fa-file-excel"></i> @L["ExportToExcel"]</button>
      <button type="button" class="btn btn-outline btn-sm" id="payBillPrint" disabled><i class="fa-solid fa-print"></i> @L["Print"]</button>
      <button type="button" class="btn btn-primary btn-sm" id="payBillGenerate"><i class="fa-solid fa-calculator"></i> @L["GeneratePayBill"]</button>
    </div>
  </div>

  <div class="card pay-bill-controls">
    <div class="card-body">
      <div class="pay-bill-filter">
        <label class="form-group pay-bill-staff-filter"><span class="form-label">@L["StaffName"]</span>
          <select class="form-control" id="payBillStaffFilter" aria-label="@L["StaffName"]">
            <option value="">@L["AllStaff"]</option>
          </select>
        </label>
        <label class="form-group"><span class="form-label">@L["Month"]</span>
          <select class="form-control" id="payBillMonth" aria-label="@L["Month"]">
            @foreach (var month in months) { <option value="@month.Key" selected="@(month.Key == DateTime.Today.Month)">@month.Value</option> }
          </select>
        </label>
        <label class="form-group"><span class="form-label">@L["Year"]</span>
          <select class="form-control" id="payBillYear" aria-label="@L["Year"]">
            @foreach (var year in years) { <option value="@year" selected="@(year == DateTime.Today.Year)">@year</option> }
          </select>
        </label>
        <div class="pay-bill-period" id="payBillPeriod"></div>
      </div>
      <div class="form-error" id="payBillError" role="alert"></div>
    </div>
  </div>

  <section class="card">
    <div class="card-header">
      <div class="card-title"><i class="fa-solid fa-users"></i> @L["EmployeeSalaryStatement"] <span class="tab-count" id="payBillCount">0</span></div>
    </div>
    <div class="table-container">
      <table class="data-table pay-bill-table">
        <thead><tr>
          <th>@L["EmployeeID"]</th><th>@L["StaffName"]</th><th>@L["Department"]</th><th>@L["Designation"]</th>
          <th>@L["PaidDays"]</th><th>@L["MonthlySalary"]</th><th>@L["BasicPay"]</th><th>@L["Allowances"]</th>
          <th>@L["OTHours"]</th><th>@L["OvertimeAmount"]</th><th>@L["Deductions"]</th><th>@L["NetPay"]</th>
        </tr></thead>
        <tbody id="payBillBody"></tbody>
        <tfoot id="payBillFoot"></tfoot>
      </table>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-column"></i> @L["MonthlyConsolidatedPayBill"]</div></div>
    <div class="table-container">
      <table class="data-table pay-bill-table pay-bill-summary">
        <thead><tr><th>@L["Department"]</th><th>@L["Employees"]</th><th>@L["BasicPay"]</th><th>@L["Allowances"]</th><th>@L["OvertimeAmount"]</th><th>@L["Deductions"]</th><th>@L["NetPay"]</th></tr></thead>
        <tbody id="payBillSummaryBody"></tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-clock-rotate-left"></i> @L["PreviousSalaryHistory"]</div></div>
    <div class="card-body">
      <label class="form-group pay-bill-history-select"><span class="form-label">@L["SelectEmployee"]</span>
        <select class="form-control" id="payBillHistoryEmployee" aria-label="@L["SelectEmployee"]"><option value="">@L["SelectEmployee"]</option></select>
      </label>
      <div class="table-container">
        <table class="data-table pay-bill-table pay-bill-summary">
          <thead><tr><th>@L["Month"]</th><th>@L["PaidDays"]</th><th>@L["BasicPay"]</th><th>@L["Allowances"]</th><th>@L["OvertimeAmount"]</th><th>@L["Deductions"]</th><th>@L["NetPay"]</th></tr></thead>
          <tbody id="payBillHistoryBody"><tr><td colspan="7" class="empty-state">@L["SelectEmployee"]</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>
  @Html.AntiForgeryToken()
</main>
@section Styles {
  <style>
    .pay-bill-controls { margin-bottom:18px; }
    .pay-bill-filter { display:flex; gap:14px; align-items:end; flex-wrap:wrap; }
    .pay-bill-filter .form-group { margin:0; min-width:150px; }
    .pay-bill-filter .pay-bill-staff-filter { min-width:240px; }
    .pay-bill-period { color:var(--text-muted); font-size:.85rem; padding:10px 0; }
    .pay-bill-table { min-width:1200px; }
    .pay-bill-table th,.pay-bill-table td { text-align:right; white-space:nowrap; }
    .pay-bill-table th:first-child,.pay-bill-table td:first-child,
    .pay-bill-table th:nth-child(2),.pay-bill-table td:nth-child(2),
    .pay-bill-table th:nth-child(3),.pay-bill-table td:nth-child(3),
    .pay-bill-table th:nth-child(4),.pay-bill-table td:nth-child(4) { text-align:left; }
    .pay-bill-table input { width:100px; min-width:80px; padding:6px 8px; text-align:right; }
    .pay-bill-summary { min-width:900px; }
    .pay-bill-history-select { display:block; max-width:380px; margin-bottom:16px; }
    #payBillError { display:none; margin-bottom:12px; }
    @@media(max-width:700px) { .page-actions { flex-wrap:wrap; } .pay-bill-filter .form-group { flex:1 1 130px; } }
  </style>
}
@section Scripts {
  <script>
    window.PayBillI18n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
      EmployeeID = L["EmployeeID"].Value, StaffName = L["StaffName"].Value, Department = L["Department"].Value,
      Designation = L["Designation"].Value, PaidDays = L["PaidDays"].Value, MonthlySalary = L["MonthlySalary"].Value,
      BasicPay = L["BasicPay"].Value, Allowances = L["Allowances"].Value, OvertimeAmount = L["OvertimeAmount"].Value,
      OTHours = L["OTHours"].Value, Deductions = L["Deductions"].Value, NetPay = L["NetPay"].Value,
      Employees = L["Employees"].Value, GrandTotal = L["GrandTotal"].Value, SelectEmployee = L["SelectEmployee"].Value,
      NoStaffForAttendance = L["NoStaffForAttendance"].Value, NoPayrollHistory = L["NoPayrollHistory"].Value,
      PayrollSaved = L["PayrollSaved"].Value, PayrollLoadFailed = L["PayrollLoadFailed"].Value,
      PayrollSaveFailed = L["PayrollSaveFailed"].Value, CouldNotReachServer = L["CouldNotReachServer"].Value,
      ConfirmGeneratePayBill = L["ConfirmGeneratePayBill"].Value, Draft = L["Draft"].Value,
      AllStaff = L["AllStaff"].Value
    }));
  </script>
  <script src="~/js/payroll.js" asp-append-version="true"></script>
}
