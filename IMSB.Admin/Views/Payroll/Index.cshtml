@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    var years = (List<int>)ViewBag.Years;
    var months = (List<KeyValuePair<int, string>>)ViewBag.Months;
}
<main class="page-body">
  <div class="page-header">
    <div>
      <div class="page-title">@L["PayBillTitle"]</div>
      <div class="page-subtitle">@L["PayBillSubtitle"]</div>
    </div>
    <div class="page-actions">
      <div class="export-menu" id="payBillExportMenu">
        <button type="button" class="btn btn-outline btn-sm" id="payBillExportBtn" aria-haspopup="menu" aria-expanded="false" aria-controls="payBillExportList">
          <i class="fa-solid fa-download"></i> @L["Export"] <i class="fa-solid fa-chevron-down export-caret" aria-hidden="true"></i>
        </button>
        <div class="export-list" id="payBillExportList" role="menu" aria-labelledby="payBillExportBtn" hidden>
          <button type="button" role="menuitem" id="payBillExportPdfBtn"><i class="fa-solid fa-file-pdf" style="color:#dc2626"></i> @L["ExportPdf"]</button>
          <button type="button" role="menuitem" id="payBillExportExcelBtn"><i class="fa-solid fa-file-excel" style="color:#16a34a"></i> @L["ExportCsv"]</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Monthly consolidated pay bill: net pay per department (plus an overall total) in one row, filled by payroll.js -->
  <div class="pay-dept-grid" id="payBillSummaryBody" aria-label="@L["MonthlyConsolidatedPayBill"]"></div>

  <div class="card pay-bill-controls">
    <div class="card-body">
      <div class="pay-bill-filter">
        <label class="form-group pay-bill-staff-filter"><span class="form-label">@L["StaffName"]</span>
          <select class="form-control" id="payBillStaffFilter" aria-label="@L["StaffName"]">
            <option value="">@L["AllStaff"]</option>
          </select>
        </label>
        <label class="form-group"><span class="form-label">@L["Month"]</span>
          <select class="form-control" id="payBillMonth" aria-label="@L["Month"]">
            @foreach (var month in months) { <option value="@month.Key" selected="@(month.Key == DateTime.Today.Month)">@month.Value</option> }
          </select>
        </label>
        <label class="form-group"><span class="form-label">@L["Year"]</span>
          <select class="form-control" id="payBillYear" aria-label="@L["Year"]">
            @foreach (var year in years) { <option value="@year" selected="@(year == DateTime.Today.Year)">@year</option> }
          </select>
        </label>
        <div class="pay-bill-period" id="payBillPeriod"></div>
      </div>
      <div class="form-error" id="payBillError" role="alert"></div>
    </div>
  </div>

  <section class="card">
    <div class="card-header">
      <div class="card-title"><i class="fa-solid fa-users"></i> @L["EmployeeSalaryStatement"] <span class="tab-count" id="payBillCount">0</span></div>
    </div>
    <div class="table-container">
      <table class="data-table pay-bill-table">
        <thead><tr>
          <th>@L["EmployeeID"]</th><th>@L["StaffName"]</th><th>@L["Department"]</th><th>@L["Designation"]</th>
          <th>@L["PaidDays"]</th><th>@L["MonthlySalary"]</th><th>@L["OvertimeAmount"]</th><th>@L["LOPDeduction"]</th><th>@L["NetPay"]</th>
        </tr></thead>
        <tbody id="payBillBody"></tbody>
        <tfoot id="payBillFoot"></tfoot>
      </table>
    </div>
  </section>
</main>
@section Styles {
  <style>
    .export-menu { position:relative; display:inline-block; }
    .export-caret { font-size:.7em; margin-left:4px; transition:transform .15s; }
    .export-menu [aria-expanded="true"] .export-caret { transform:rotate(180deg); }
    .export-list { position:absolute; right:0; top:calc(100% + 4px); z-index:50; min-width:170px; padding:4px; background:var(--surface); border:1px solid var(--border); border-radius:8px; box-shadow:0 8px 24px rgba(15,23,42,.14); }
    .export-list button { display:flex; align-items:center; gap:8px; width:100%; padding:8px 10px; border:0; border-radius:6px; background:none; color:var(--text); font:inherit; font-size:.85rem; text-align:left; cursor:pointer; }
    .export-list button:hover,.export-list button:focus-visible { background:var(--primary-xlight); outline:none; }
    .pay-bill-controls { margin-bottom:18px; }    .pay-bill-filter { display:flex; gap:14px; align-items:end; flex-wrap:wrap; }
    .pay-bill-filter .form-group { margin:0; min-width:150px; }
    .pay-bill-filter .pay-bill-staff-filter { min-width:240px; }
    .pay-bill-period { color:var(--text-muted); font-size:.85rem; padding:10px 0; }
    .pay-bill-table { min-width:1000px; }
    .pay-bill-table th,.pay-bill-table td { text-align:right; white-space:nowrap; }
    .pay-bill-table th:first-child,.pay-bill-table td:first-child,
    .pay-bill-table th:nth-child(2),.pay-bill-table td:nth-child(2),
    .pay-bill-table th:nth-child(3),.pay-bill-table td:nth-child(3),
    .pay-bill-table th:nth-child(4),.pay-bill-table td:nth-child(4) { text-align:left; }
    /* the label spans the first five columns, so the totals are the 2nd-5th cells but sit under the money columns */
    .pay-bill-table tfoot td:not(:first-child) { text-align:right; }
    .pay-bill-table .lop { color:var(--danger); }
    /* every card on a single row; scrolls sideways only if the screen is too narrow */
    .pay-dept-grid { display:grid; grid-auto-flow:column; grid-auto-columns:minmax(140px, 1fr); gap:12px; overflow-x:auto; padding-bottom:4px; margin-bottom:18px; }
    .pay-dept-card { min-width:0; border:1px solid var(--border); border-top:3px solid var(--primary-light); border-radius:12px; padding:12px 14px; background:var(--card, #fff); box-shadow:var(--shadow-sm, 0 1px 3px rgba(15,23,42,.06)); display:flex; flex-direction:column; gap:8px; }
    .pay-dept-card.total { border-top-color:var(--success); background:linear-gradient(180deg, var(--primary-xlight), transparent 70%); }
    .pay-dept-head { display:flex; align-items:center; justify-content:space-between; gap:8px; }
    .pay-dept-name { font-weight:700; font-size:.88rem; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .pay-dept-emp { flex:none; font-size:.68rem; font-weight:700; padding:2px 8px; border-radius:20px; background:var(--primary-xlight); color:var(--primary); }
    .pay-dept-emp i { margin-right:3px; }
    .pay-dept-net-label { font-size:.66rem; text-transform:uppercase; letter-spacing:.5px; color:var(--text-muted); font-weight:600; }
    .pay-dept-net { font-size:1.2rem; font-weight:800; color:var(--primary); line-height:1.15; overflow-wrap:anywhere; }
    .pay-dept-card.total .pay-dept-net { color:var(--success); }
    #payBillError { display:none; margin-bottom:12px; }
    @@media(max-width:700px) { .page-actions { flex-wrap:wrap; } .pay-bill-filter .form-group { flex:1 1 130px; } }
  </style>
}
@section Scripts {
  <script>
    window.PayBillI18n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
      EmployeeID = L["EmployeeID"].Value, StaffName = L["StaffName"].Value, Department = L["Department"].Value,
      Designation = L["Designation"].Value, PaidDays = L["PaidDays"].Value, MonthlySalary = L["MonthlySalary"].Value,
      NetPay = L["NetPay"].Value, OvertimeAmount = L["OvertimeAmount"].Value, LOPDeduction = L["LOPDeduction"].Value,
      Employees = L["Employees"].Value, GrandTotal = L["GrandTotal"].Value, SelectEmployee = L["SelectEmployee"].Value,
      NoStaffForAttendance = L["NoStaffForAttendance"].Value, NoPayrollHistory = L["NoPayrollHistory"].Value,
      PayrollLoadFailed = L["PayrollLoadFailed"].Value, CouldNotReachServer = L["CouldNotReachServer"].Value,
      AllStaff = L["AllStaff"].Value, PdfExportFailed = L["PdfExportFailed"].Value
    }));
  </script>
  <script src="~/js/payroll.js" asp-append-version="true"></script>
}
