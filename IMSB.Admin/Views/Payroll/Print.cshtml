@model IMSB.Models.PayBillPrintModel
@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    Layout = null;
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@Model.Title - @Model.Period</title>
  <style>
    body { margin:24px; background:#fff; }
    .actions { display:flex; justify-content:flex-end; gap:8px; margin-bottom:14px; font:12px Arial,sans-serif; }
    .actions button { font:inherit; padding:7px 14px; border-radius:8px; border:1px solid #d6dce8; background:#fff; cursor:pointer; }
    .actions button.primary { background:#1a3c6e; color:#fff; border-color:#1a3c6e; }
    @@media print { body { margin:0; } .actions { display:none; } @@page { size:A4 landscape; margin:10mm; } }
  </style>
</head>
<body>
  <div class="actions">
    <button type="button" onclick="window.close()">@L["Close"]</button>
    <button type="button" class="primary" onclick="window.print()">@L["PrintSavePdf"]</button>
  </div>
  <partial name="_PayBillDocument" model="Model" />
</body>
</html>
