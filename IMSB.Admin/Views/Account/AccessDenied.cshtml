@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    ViewData["Title"] = L["AccessDenied"].Value;
}

<main class="page-body">
    <div class="card" style="max-width:560px;margin:40px auto">
        <div class="card-body" style="text-align:center;padding:32px">
            <i class="fa-solid fa-lock" style="font-size:2rem;color:var(--text-muted)"></i>
            <div class="page-title" style="margin-top:12px">@L["AccessDenied"]</div>
            <p style="color:var(--text-muted);margin-top:8px">@L["AccessDeniedMsg"]</p>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin-top:16px">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline btn-sm"><i class="fa-solid fa-right-from-bracket"></i> @L["SignInDifferentUser"]</button>
            </form>
        </div>
    </div>
</main>
