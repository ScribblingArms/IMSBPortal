@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    // Same shared resources as the header/sidebar (Resources/SharedResource.<culture>.resx)
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    ViewData["Title"] = L["StaffTitle"].Value;
    var canViewSalary = User.IsInRole("Admin");

    // Strings used by staff.js (table, toasts, client-side validation)
    var jsKeys = new[] {
        "Active", "OnLeave", "Inactive", "AllDepartments", "SelectPlaceholder", "NoDepartmentsConfigured", "NoStaffFound",
        "PercentOfTotal", "View", "Edit", "Delete", "Success", "Error", "StaffRegistered", "StaffUpdated", "StaffDeleted",
        "StaffNotFound", "ConfirmDeleteStaff", "DiscardChanges", "CouldNotSave", "CouldNotDelete", "CouldNotReachServer",
        "CheckForm", "ViewingProfile", "StaffTitle", "StaffProfile", "AutoGenerated",
        "EmployeeID", "FullName", "Department", "Designation", "StaffCategory", "Mobile", "Email", "DateOfBirth",
        "Gender", "JoinDate", "Shift", "Status", "MonthlySalary",
        "ValFullName", "ValMobile", "ValEmail", "ValDobRequired", "ValDobFuture", "ValMinAge", "ValDepartment",
        "ValDesignation", "ValStaffCategory", "ValJoinRequired", "ValJoinFuture", "ValJoinAfterDob", "ValMonthlySalary"
    };
    var jsStrings = jsKeys.ToDictionary(k => k, k => L[k].Value);
}

    <main class="page-body">
      <div class="page-header">
        <div><div class="page-title">@L["StaffHRManagement"]</div><div class="page-subtitle">@L["StaffHRSubtitle"]</div></div>
        <div class="page-actions">
          <button type="button" class="btn btn-outline btn-sm" id="staffExportBtn"><i class="fa-solid fa-download"></i> @L["Export"]</button>
          <button type="button" class="btn btn-primary btn-sm" data-modal-open="addStaffModal"><i class="fa-solid fa-user-plus"></i> @L["AddStaff"]</button>
        </div>
      </div>

      <!-- Stats + Dept-wise counts in one row -->
      <div class="staff-overview">
        <div class="stat-grid staff-stat-grid">
          <div class="stat-card blue"><div class="staff-stat-head"><div class="stat-icon"><i class="fa-solid fa-users"></i></div><div class="stat-value" id="statTotalStaff">@ViewBag.TotalStaff</div></div><div class="stat-label">@L["TotalStaff"]</div></div>
          <div class="stat-card green"><div class="staff-stat-head"><div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div><div class="stat-value" id="statActiveStaff">@ViewBag.ActiveStaff</div></div><div class="stat-label">@L["Active"]</div></div>
          <div class="stat-card orange"><div class="staff-stat-head"><div class="stat-icon"><i class="fa-solid fa-clock"></i></div><div class="stat-value" id="statOnLeave">@ViewBag.OnLeave</div></div><div class="stat-label">@L["OnLeave"]</div></div>
          <div class="stat-card indigo"><div class="staff-stat-head"><div class="stat-icon"><i class="fa-solid fa-building"></i></div><div class="stat-value" id="statDepartments">@ViewBag.Departments</div></div><div class="stat-label">@L["Departments"]</div></div>
          <div class="stat-card red"><div class="staff-stat-head"><div class="stat-icon"><i class="fa-solid fa-calendar-times"></i></div><div class="stat-value" id="statContractExpiring">@ViewBag.ContractExpiring</div></div><div class="stat-label">@L["ContractExpiring"]</div></div>
        </div>

        <div class="card staff-dept-card">
          <div class="card-header"><div class="card-title"><i class="fa-solid fa-building"></i> @L["DeptWiseStaffCount"]</div></div>
          <div class="card-body">
            <div class="staff-dept-grid" id="deptCards"></div>
          </div>
        </div>
      </div>

      <!-- Chart (hidden for now; staff.js still fills it) + Staff list -->
      <div style="display:grid;grid-template-columns:minmax(0,1fr);gap:18px;margin-bottom:20px">
        <div class="card" style="display:none">
          <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-pie"></i> @L["DeptDistribution"]</div></div>
          <div class="card-body"><div style="height:230px"><canvas id="staffDeptChart"></canvas></div></div>
        </div>
        <div class="card">
          <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-list"></i> @L["StaffDirectory"]</div>
          </div>
          <div class="card-body">
            <div class="toolbar">
              <div class="search-box"><i class="fa-solid fa-search"></i><input type="text" id="staffSearch" data-url-search placeholder="@L["SearchStaff"]" aria-label="@L["SearchStaff"]"></div>
              <select id="staffFilterDepartment" class="form-control" style="width:auto;min-width:170px" aria-label="@L["FilterByDepartment"]"><option value="">@L["AllDepartments"]</option></select>
              <select id="staffFilterStatus" class="form-control" style="width:auto;min-width:130px" aria-label="@L["FilterByStatus"]">
                <option value="">@L["AllStatus"]</option>
                <option value="ACTIVE">@L["Active"]</option>
                <option value="ON_LEAVE">@L["OnLeave"]</option>
                <option value="INACTIVE">@L["Inactive"]</option>
              </select>
            </div>
            <div class="table-container staff-table-scroll">
              <table class="data-table" id="staffTable">
                <thead><tr><th>@L["StaffID"]</th><th>@L["Name"]</th><th>@L["Department"]</th><th>@L["Designation"]</th><th>@L["Shift"]</th><th>@L["Actions"]</th></tr></thead>
                <tbody id="staffBody"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>

<!-- Add / Edit Staff Modal (markup mirrors IMSB_ADMIN_PANEL/pages/staff.html) -->
<div class="modal-overlay" id="addStaffModal" aria-hidden="true">
  <div class="modal" style="max-width:600px" role="dialog" aria-modal="true" aria-labelledby="staffModalTitle"
       data-add-title="@L["AddNewStaffMember"]" data-edit-title="@L["EditStaffMember"]"
       data-register-text="@L["RegisterStaff"]" data-update-text="@L["UpdateStaff"]">
    <div class="modal-header">
      <div class="modal-title" id="staffModalTitle">@L["AddNewStaffMember"]</div>
      <button type="button" class="modal-close" id="staffModalClose" aria-label="@L["Cancel"]"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body">
      <form id="staffForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" id="staffInternalId" />
        <div class="form-section-title"><i class="fa-solid fa-user"></i> @L["PersonalDetails"]</div>
        <div class="form-grid col-2">
          <div class="form-group">
            <label class="form-label" for="staffFullName">@L["FullName"] <span class="req">*</span></label>
            <input id="staffFullName" name="full_name" class="form-control" placeholder="@L["FullName"]" maxlength="100" required />
            <div class="form-error" id="err_full_name"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="staffEmployeeId">@L["EmployeeID"]</label>
            <input id="staffEmployeeId" class="form-control" placeholder="@L["AutoGenerated"]" disabled />
          </div>
          <div class="form-group">
            <label class="form-label" for="staffMobile">@L["Mobile"] <span class="req">*</span></label>
            <input id="staffMobile" name="mobile" type="tel" class="form-control" maxlength="12" inputmode="numeric" required />
            <div class="form-error" id="err_mobile"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="staffEmail">@L["Email"]</label>
            <input id="staffEmail" name="email" type="email" class="form-control" maxlength="200" />
            <div class="form-error" id="err_email"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="staffDOB">@L["DateOfBirth"] <span class="req">*</span></label>
            <input id="staffDOB" name="date_of_birth" type="date" class="form-control" required />
            <div class="form-error" id="err_date_of_birth"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="staffGender">@L["Gender"]</label>
            <select id="staffGender" name="gender" class="form-control">
              <option value="Female">@L["Female"]</option>
              <option value="Male">@L["Male"]</option>
              <option value="Other">@L["Other"]</option>
            </select>
            <div class="form-error" id="err_gender"></div>
          </div>
        </div>

        <div class="form-section-title" style="margin-top:18px"><i class="fa-solid fa-briefcase"></i> @L["EmploymentDetails"]</div>
        <div class="form-grid col-2">
          <div class="form-group">
            <label class="form-label" for="staffDepartment">@L["Department"] <span class="req">*</span></label>
            <select id="staffDepartment" name="department_id" class="form-control" required>
              <option value="">@L["SelectPlaceholder"]</option>
            </select>
            <div class="form-error" id="err_department_id"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="staffDesignation">@L["Designation"] <span class="req">*</span></label>
            <input id="staffDesignation" name="designation" class="form-control" placeholder="@L["DesignationPlaceholder"]" maxlength="100" required />
            <div class="form-error" id="err_designation"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="staffCategory">@L["StaffCategory"] <span class="req">*</span></label>
            <input id="staffCategory" name="staff_category" class="form-control" placeholder="@L["StaffCategory"]" maxlength="100" required />
            <div class="form-error" id="err_staff_category"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="staffJoinDate">@L["JoinDate"] <span class="req">*</span></label>
            <input id="staffJoinDate" name="join_date" type="date" class="form-control" required />
            <div class="form-error" id="err_join_date"></div>
          </div>
          @if (User.IsInRole("Admin"))
          {
            <div class="form-group">
              <label class="form-label" for="staffMonthlySalary">@L["MonthlySalary"]</label>
              <input id="staffMonthlySalary" name="monthly_salary" type="number" class="form-control" min="0" max="999999999.99" step="0.01" required />
              <div class="form-error" id="err_monthly_salary"></div>
            </div>
          }
          <div class="form-group">
            <label class="form-label" for="staffShift">@L["Shift"]</label>
            <select id="staffShift" name="shift" class="form-control"></select>
            <div class="form-error" id="err_shift"></div>
          </div>
          <div class="form-group" id="staffStatusGroup" style="display:none">
            <label class="form-label" for="staffStatus">@L["Status"]</label>
            <select id="staffStatus" name="status" class="form-control">
              <option value="ACTIVE">@L["Active"]</option>
              <option value="ON_LEAVE">@L["OnLeave"]</option>
              <option value="INACTIVE">@L["Inactive"]</option>
            </select>
            <div class="form-error" id="err_status"></div>
          </div>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" id="staffCancelBtn">@L["Cancel"]</button>
      <button type="button" class="btn btn-primary" id="staffSubmitBtn"><i class="fa-solid fa-check"></i> <span id="staffSubmitBtnText">@L["RegisterStaff"]</span></button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="staffProfileModal" aria-hidden="true">
  <div class="modal" style="max-width:620px" role="dialog" aria-modal="true" aria-labelledby="staffProfileTitle">
    <div class="modal-header">
      <div class="modal-title" id="staffProfileTitle">@L["StaffProfile"]</div>
      <button type="button" class="modal-close" data-modal-close aria-label="@L["Close"]"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body" id="staffProfileBody"></div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" data-modal-close>@L["Close"]</button>
    </div>
  </div>
</div>

@section Styles {
  <style>
    .staff-overview { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16px; margin-bottom:20px; align-items:stretch; }
    /* Total Staff is a tall card on the left; the other four sit in a 2x2 block beside it */
    .staff-stat-grid { grid-template-columns:repeat(3, minmax(0,1fr)); grid-auto-rows:1fr; gap:12px; margin:0; }
    .staff-stat-grid .stat-card { min-width:0; padding:12px 14px; display:flex; flex-direction:column; justify-content:center; }
    .staff-stat-grid .stat-card:first-child { grid-row:span 2; }
    /* Total Staff: icon, then label, then the count stacked underneath */
    .staff-stat-grid .stat-card:first-child { align-items:center; text-align:center; gap:14px; }
    .staff-stat-grid .stat-card:first-child .staff-stat-head { display:contents; }
    .staff-stat-grid .stat-card:first-child .stat-icon { order:0; }
    .staff-stat-grid .stat-card:first-child .stat-label { order:1; }
    .staff-stat-grid .stat-card:first-child .stat-value { order:2; font-size:2.4rem; line-height:1.1; }
    .staff-stat-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:6px; }
    .staff-stat-grid .stat-icon { width:34px; height:34px; flex:none; font-size:.9rem; margin:0; }
    .staff-stat-grid .stat-value { font-size:1.55rem; margin:0; }
    .staff-stat-grid .stat-label { font-size:.78rem; line-height:1.25; }
    .staff-dept-card { margin:0; }
    .staff-dept-card .card-header { padding:12px 18px; }
    .staff-dept-card .card-body { padding:10px 18px 14px; }
    .staff-dept-grid { display:flex; flex-direction:column; gap:10px; }
    .dept-bar-row { display:grid; grid-template-columns:minmax(90px,130px) 1fr 28px 40px; align-items:center; gap:12px; font-size:.8rem; }
    .dept-bar-name { font-weight:600; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .dept-bar-track { height:8px; border-radius:99px; background:var(--border, #e2e8f0); overflow:hidden; }
    .dept-bar-fill { height:100%; border-radius:99px; transition:width .3s; }
    .dept-bar-count { font-weight:800; text-align:right; color:var(--text); }
    .dept-bar-pct { font-size:.72rem; color:var(--text-muted); text-align:right; }
    /* Staff Directory: about 7 rows visible, the rest scroll under a fixed header */
    .staff-table-scroll { max-height:340px; overflow-y:auto; }
    .staff-table-scroll thead th { position:sticky; top:0; z-index:1; padding:8px 12px; }
    /* compact rows */
    #staffTable td { padding:6px 12px; font-size:.78rem; }
    #staffTable td strong { font-size:.8rem; }
    #staffTable td > div > div:first-child { width:24px !important; height:24px !important; font-size:.58rem !important; }
    #staffTable .btn-icon { padding:3px 6px; font-size:.75rem; }
    @@media (max-width: 1300px) { .staff-overview { grid-template-columns:minmax(0,1fr); } }
    @@media (max-width: 600px) {
      .staff-stat-grid { grid-template-columns:repeat(2, minmax(0,1fr)); }
      .staff-stat-grid .stat-card:first-child { grid-row:auto; grid-column:span 2; }
    }
  </style>
}

@section Scripts {
    <script>window.StaffI18n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jsStrings)); window.StaffCanViewSalary = @canViewSalary.ToString().ToLowerInvariant(); window.StaffOpenCreate = @((bool)(ViewBag.RegisterOnLoad ?? false) ? "true" : "false");</script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/staff.js" asp-append-version="true"></script>
}
