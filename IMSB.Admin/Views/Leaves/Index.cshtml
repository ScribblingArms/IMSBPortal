@model IMSB.Dto.Models.LeaveManagementViewModel
@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    ViewData["Title"] = L["LeaveManagement"].Value;
}

<main class="page-body">
  <div class="page-header">
    <div><div class="page-title">@L["LeaveManagement"] – @Model.Year</div><div class="page-subtitle">@L["LeaveManagementSubtitle"]</div></div>
    <div class="page-actions">
      <a class="btn btn-outline btn-sm" href="@Url.Action("Index", "Staff", new { register = true })"><i class="fa-solid fa-user-plus"></i> @L["RegisterStaff"]</a>
      <a class="btn btn-primary btn-sm" href="@Url.Action("Add")"><i class="fa-solid fa-plus"></i> @L["AddLeaveTaken"]</a>
    </div>
  </div>

  @if (TempData["LeaveMessage"] is string message)
  {
    <div class="alert alert-success" role="status">@message</div>
  }
  @if (TempData["LeaveError"] is string error)
  {
    <div class="alert alert-danger" role="alert">@error</div>
  }

  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-scale-balanced"></i> @L["CurrentLeaveBalances"] (@Model.Year)</div></div>
    <div class="card-body">
      <div id="leaveBalanceRefreshStatus" class="form-hint" role="status" aria-live="polite"></div>
      <div class="form-grid col-3" style="margin-bottom:16px">
        <div class="form-group">
          <label class="form-label" for="balanceStaffFilter">@L["StaffName"]</label>
          <select id="balanceStaffFilter" class="form-control">
            <option value="">@L["AllStaff"]</option>
            @foreach (var person in Model.Staff)
            {
              <option value="@person.EmployeeId">@person.EmployeeId – @person.FullName</option>
            }
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="balanceLeaveTypeFilter">@L["LeaveType"]</label>
          <select id="balanceLeaveTypeFilter" class="form-control">
            <option value="">@L["AllTypes"]</option>
            @foreach (var leaveType in Model.Entitlements.Select(item => item.LeaveType).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(value => value))
            {
              <option value="@leaveType">@leaveType</option>
            }
          </select>
        </div>
        <div class="form-group" style="align-self:end">
          <button type="button" id="searchLeaveBalances" class="btn btn-primary btn-sm" style="width:max-content"><i class="fa-solid fa-plus"></i> @L["Search"]</button>
        </div>
      </div>
      <div class="table-container">
        <!-- Tree: one row per employee (totals), its leave types nested underneath. Filled by the script below. -->
        <table class="data-table leave-tree">
          <thead><tr><th>@L["StaffName"] / @L["LeaveType"]</th><th>@L["StaffCategory"]</th><th>@L["AnnualQuota"]</th><th>@L["Taken"]</th><th>@L["Balance"]</th></tr></thead>
          <tbody id="leaveBalancesBody" data-empty-message="@L["NoLeaveBalances"]" data-refresh-error="@L["BalanceRefreshFailed"]"></tbody>
        </table>
      </div>
    </div>
  </div>
</main>

@section Styles {
  <style>
    .leave-tree-parent { cursor:pointer; background:var(--card, #fff); }
    .leave-tree-parent:hover { background:var(--bg); }
    .leave-tree-parent td { font-weight:500; }
    .leave-tree-parent code { margin:0 6px 0 2px; }
    .leave-tree-toggle { display:inline-flex; width:18px; justify-content:center; color:var(--text-muted); }
    .leave-tree-toggle i { font-size:.7rem; transition:transform .15s; }
    .leave-tree-parent.open .leave-tree-toggle i { transform:rotate(90deg); color:var(--primary); }
    .leave-tree-count { margin-left:6px; font-size:.65rem; font-weight:700; padding:1px 7px; border-radius:20px; background:var(--primary-xlight); color:var(--primary); }
    .leave-tree-child td { font-size:.8rem; color:var(--text-muted); padding-top:7px; padding-bottom:7px; }
    .leave-tree-child td:first-child { color:var(--text); }
    /* tree connector: vertical line from the parent, elbow into each leave type */
    .leave-tree-branch { position:relative; display:inline-block; width:22px; height:1em; margin-left:8px; margin-right:6px; vertical-align:middle; }
    .leave-tree-branch::before { content:""; position:absolute; left:0; top:-14px; bottom:50%; border-left:2px solid var(--border); }
    .leave-tree-branch::after { content:""; position:absolute; left:0; right:2px; top:50%; border-top:2px solid var(--border); }
    .leave-tree-child:not(.last) .leave-tree-branch::before { bottom:-14px; }
  </style>
}

@section Scripts {
<script>
(() => {
  const body = document.getElementById('leaveBalancesBody');
  const status = document.getElementById('leaveBalanceRefreshStatus');
  const staffFilter = document.getElementById('balanceStaffFilter');
  const leaveTypeFilter = document.getElementById('balanceLeaveTypeFilter');
  const searchButton = document.getElementById('searchLeaveBalances');
  const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, character =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
  const formatDays = value => Number(value).toLocaleString(undefined, { maximumFractionDigits: 2 });
  const attendanceChannel = 'BroadcastChannel' in window ? new BroadcastChannel('imsb-leave-balances') : null;
  let appliedEmployeeId = '';
  let appliedLeaveType = '';
  let refreshSequence = 0;
  const expanded = new Set();   // employee ids opened by the user; kept across the periodic refresh

  // Groups the flat balance rows by employee: a parent row with totals, then one child row per leave type
  function renderTree(rows) {
    if (!rows.length) {
      body.innerHTML = `<tr><td colspan="5" style="text-align:center">${escapeHtml(body.dataset.emptyMessage)}</td></tr>`;
      return;
    }
    const groups = new Map();
    rows.forEach(row => {
      if (!groups.has(row.employeeId)) groups.set(row.employeeId, { employeeId: row.employeeId, staffName: row.staffName, staffCategory: row.staffCategory, items: [] });
      groups.get(row.employeeId).items.push(row);
    });
    const sum = (items, key) => items.reduce((total, item) => total + Number(item[key] || 0), 0);
    body.innerHTML = [...groups.values()].map(g => {
      const open = expanded.has(g.employeeId);   // closed unless the user opened it
      const parent = `<tr class="leave-tree-parent${open ? ' open' : ''}" data-staff-id="${escapeHtml(g.employeeId)}" tabindex="0" aria-expanded="${open}">
          <td><span class="leave-tree-toggle"><i class="fa-solid fa-chevron-right"></i></span>
            <code>${escapeHtml(g.employeeId)}</code> <strong>${escapeHtml(g.staffName)}</strong>
            <span class="leave-tree-count">${g.items.length}</span></td>
          <td>${escapeHtml(g.staffCategory)}</td>
          <td>${formatDays(sum(g.items, 'entitlement'))}</td>
          <td>${formatDays(sum(g.items, 'taken'))}</td>
          <td><strong>${formatDays(sum(g.items, 'balance'))}</strong></td>
        </tr>`;
      const children = g.items.map((row, i) => `<tr class="leave-tree-child${i === g.items.length - 1 ? ' last' : ''}" data-parent="${escapeHtml(g.employeeId)}"
            data-leave-type="${escapeHtml(row.leaveType)}"${open ? '' : ' hidden'}>
          <td><span class="leave-tree-branch"></span>${escapeHtml(row.leaveType)}</td>
          <td></td>
          <td>${formatDays(row.entitlement)}</td>
          <td>${formatDays(row.taken)}</td>
          <td><strong>${formatDays(row.balance)}</strong></td>
        </tr>`).join('');
      return parent + children;
    }).join('');
  }

  function toggle(parentRow) {
    const id = parentRow.dataset.staffId;
    const open = !parentRow.classList.contains('open');
    parentRow.classList.toggle('open', open);
    parentRow.setAttribute('aria-expanded', open);
    if (open) expanded.add(id); else expanded.delete(id);
    body.querySelectorAll('tr[data-parent]').forEach(child => { if (child.dataset.parent === id) child.hidden = !open; });
  }
  body.addEventListener('click', event => {
    const row = event.target.closest('tr.leave-tree-parent');
    if (row) toggle(row);
  });
  body.addEventListener('keydown', event => {
    const row = event.target.closest('tr.leave-tree-parent');
    if (row && (event.key === 'Enter' || event.key === ' ')) { event.preventDefault(); toggle(row); }
  });

  renderTree(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Balances, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))));

  async function refreshBalances() {
    if (document.hidden) return;
    const sequence = ++refreshSequence;
    try {
      const url = new URL('@Url.Action("CurrentBalances")', window.location.origin);
      if (appliedEmployeeId) url.searchParams.set('employeeId', appliedEmployeeId);
      if (appliedLeaveType) url.searchParams.set('leaveType', appliedLeaveType);
      const response = await fetch(url, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Balance refresh failed (${response.status})`);
      const result = await response.json();
      if (sequence !== refreshSequence) return;
      renderTree(result.rows);
      status.textContent = '';
    } catch (error) {
      if (sequence !== refreshSequence) return;
      console.error(error);
      status.textContent = body.dataset.refreshError;
    }
  }
  searchButton.addEventListener('click', () => {
    appliedEmployeeId = staffFilter.value;
    appliedLeaveType = leaveTypeFilter.value;
    refreshBalances();
  });
  attendanceChannel?.addEventListener('message', event => {
    if (event.data === 'attendance-saved') refreshBalances();
  });
  refreshBalances();
  window.setInterval(refreshBalances, 15000);
  document.addEventListener('visibilitychange', refreshBalances);
})();
</script>
}
