@model IMSB.Models.LeaveEntryViewModel
@using IMSB.Admin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory
@{
    var L = LocalizerFactory.Create("SharedResource", typeof(SharedResource).Assembly.GetName().Name!);
    ViewData["Title"] = L["AddLeaveTaken"].Value;
    var minDate = new DateTime(Model.Year, 1, 1).ToString("yyyy-MM-dd");
    var maxDate = new DateTime(Model.Year, 12, 31).ToString("yyyy-MM-dd");
}

<main class="page-body">
  <div class="page-header">
    <div><div class="page-title">@L["AddLeaveTaken"]</div><div class="page-subtitle">@L["LeaveEntrySubtitle"] (@Model.Year)</div></div>
    <div class="page-actions"><a class="btn btn-outline btn-sm" href="@Url.Action("Index")"><i class="fa-solid fa-scale-balanced"></i> @L["CurrentLeaveBalances"]</a></div>
  </div>

  @if (TempData["LeaveMessage"] is string message)
  {
    <div class="alert alert-success" role="status">@message</div>
  }
  @if (TempData["LeaveError"] is string error)
  {
    <div class="alert alert-danger" role="alert">@error</div>
  }

  <div class="card" style="margin-bottom:20px">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-calendar-plus"></i> @L["RecordLeaveTaken"]</div></div>
    <div class="card-body">
      @if (Model.Entitlements.Count == 0)
      {
        <div class="alert alert-warning">@L["ConfigureLeaveEntitlementsFirst"] <a href="@Url.Action("Index")">@L["LeaveEntitlements"]</a>.</div>
      }
      <form asp-action="Record" method="post" class="leave-entry-form">
        @Html.AntiForgeryToken()
        <div class="form-grid col-2">
          <div class="form-group">
            <label class="form-label" for="leaveStaff">@L["StaffName"]</label>
            <select id="leaveStaff" name="StaffId" class="form-control" required>
              <option value="">@L["SelectPlaceholder"]</option>
              @foreach (var person in Model.Staff)
              {
                <option value="@person.Id" data-category="@person.StaffCategory" data-employee-id="@person.EmployeeId">@person.EmployeeId – @person.FullName (@person.StaffCategory)</option>
              }
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="leaveType">@L["LeaveType"]</label>
            <select id="leaveType" name="LeaveType" class="form-control" required>
              <option value="">@L["SelectPlaceholder"]</option>
              @foreach (var leaveType in Model.LeaveTypes)
              {
                <option value="@leaveType">@leaveType</option>
              }
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="leaveFrom">@L["FromDate"]</label>
            <input id="leaveFrom" name="FromDate" type="date" class="form-control" min="@minDate" max="@maxDate" value="@Model.Form.FromDate" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="leaveTo">@L["ToDate"]</label>
            <input id="leaveTo" name="ToDate" type="date" class="form-control" min="@minDate" max="@maxDate" value="@Model.Form.ToDate" required />
          </div>
          @* Leave Balance and Days Taken side by side *@
          <div class="form-group">
            <label class="form-label" for="leaveBalance">@L["LeaveBalance"]</label>
            <input id="leaveBalance" type="text" class="form-control" disabled />
          </div>
          <div class="form-group">
            <label class="form-label" for="leaveDays">@L["DaysTaken"]</label>
            <input id="leaveDays" name="Days" type="number" class="form-control" min="1" step="1" max="366" value="1" readonly required />
          </div>
          <div class="form-group form-full">
            <label class="form-label" for="leaveRemarks">@L["Remarks"]</label>
            <textarea id="leaveRemarks" name="Remarks" class="form-control" rows="3" maxlength="500"></textarea>
          </div>
        </div>
        <div class="leave-entry-actions">
          <button type="submit" class="btn btn-primary btn-sm" disabled="@(Model.Entitlements.Count == 0)"><i class="fa-solid fa-floppy-disk"></i> @L["SaveLeaveEntry"]</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-clock-rotate-left"></i> @L["LeaveEntries"] (@Model.Year)</div></div>
    <div class="card-body">
      <div class="table-container">
        <table class="data-table">
          <thead><tr><th>@L["EmployeeID"]</th><th>@L["StaffName"]</th><th>@L["LeaveType"]</th><th>@L["FromDate"]</th><th>@L["ToDate"]</th><th>@L["DaysTaken"]</th><th>@L["Remarks"]</th><th>@L["Actions"]</th></tr></thead>
          <tbody>
          @foreach (var entry in Model.Entries)
          {
            <tr>
              <td><code>@entry.Staff?.EmployeeId</code></td><td>@entry.Staff?.FullName</td><td>@entry.LeaveType</td>
              @* the dates and days of a recorded leave are fixed; only the remarks can be changed *@
              <td class="leave-from-date">@entry.FromDate.ToString("dd-MM-yyyy")</td>
              <td class="leave-to-date">@entry.ToDate.ToString("dd-MM-yyyy")</td>
              <td class="leave-days">@((entry.ToDate.Date - entry.FromDate.Date).Days + 1)</td>
              <td>
                <form asp-action="UpdateEntry" method="post" class="leave-edit-form" style="display:flex;gap:6px;align-items:center">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@entry.Id" />
                  <input type="hidden" name="fromDate" value="@entry.FromDate.ToString("yyyy-MM-dd")" />
                  <input type="hidden" name="toDate" value="@entry.ToDate.ToString("yyyy-MM-dd")" />
                  <input name="remarks" value="@entry.Remarks" maxlength="500" class="form-control" style="width:180px" aria-label="@L["Remarks"]" />
                  <button type="submit" class="btn btn-outline btn-sm">@L["Update"]</button>
                </form>
              </td>
              <td>
                <form asp-action="DeleteEntry" method="post">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@entry.Id" />
                  <button type="submit" class="btn btn-ghost btn-sm" aria-label="@L["Delete"]" title="@L["Delete"]"><i class="fa-solid fa-trash"></i></button>
                </form>
              </td>
            </tr>
          }
          @if (Model.Entries.Count == 0)
          {
            <tr><td colspan="8" style="text-align:center">@L["NoLeaveEntries"]</td></tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<div class="modal-overlay" id="lopConfirmModal" aria-hidden="true">
  <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="lopConfirmTitle" aria-describedby="lopConfirmText" style="max-width:460px">
    <div class="modal-header">
      <div class="modal-title" id="lopConfirmTitle"><i class="fa-solid fa-triangle-exclamation"></i> @L["LopLeaveTitle"]</div>
    </div>
    <div class="modal-body"><p id="lopConfirmText" style="margin:0"></p></div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline btn-sm" id="lopConfirmNo">@L["No"]</button>
      <button type="button" class="btn btn-primary btn-sm" id="lopConfirmYes">@L["Yes"]</button>
    </div>
  </div>
</div>

@section Scripts {
<script>
(() => {
  // ── Leave balance and the switch to LOP when it is used up ──
  const lopType = @Json.Serialize(IMSB.Dto.Models.LeaveBalanceRules.LopLeaveType);
  const lopMessage = @Json.Serialize(L["LopLeaveConfirm"].Value);
  const balances = new Map(@Json.Serialize(Model.Balances.Select(b => new[] { $"{b.EmployeeId}|{b.LeaveType}".ToUpperInvariant(), b.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture) })));
  const form = document.querySelector('.leave-entry-form');
  const staffSelect = document.getElementById('leaveStaff');
  const typeSelect = document.getElementById('leaveType');
  const balanceBox = document.getElementById('leaveBalance');
  const modal = document.getElementById('lopConfirmModal');
  const isLop = type => type.trim().toUpperCase() === lopType;

  /** The selected staff member's balance of the selected type (0 when not configured); null when nothing to show. */
  function currentBalance() {
    const employeeId = staffSelect.selectedOptions[0]?.dataset.employeeId;
    const type = typeSelect.value;
    if (!employeeId || !type || isLop(type)) return null;
    return Number(balances.get(`${employeeId}|${type}`.toUpperCase()) ?? 0);
  }

  function refreshBalance() {
    const balance = currentBalance();
    balanceBox.value = balance === null ? '' : String(balance);
    return balance;
  }

  function askForLop() {
    document.getElementById('lopConfirmText').textContent = lopMessage.replace('{0}', typeSelect.value);
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.getElementById('lopConfirmYes').focus();
  }

  function closeLop() {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  }

  function checkBalance() {
    const balance = refreshBalance();
    if (balance !== null && balance <= 0) askForLop();
  }

  document.getElementById('lopConfirmYes').addEventListener('click', () => {
    typeSelect.value = [...typeSelect.options].find(option => isLop(option.value))?.value ?? lopType;
    refreshBalance();
    closeLop();
  });
  document.getElementById('lopConfirmNo').addEventListener('click', () => {
    typeSelect.value = '';
    refreshBalance();
    closeLop();
    typeSelect.focus();
  });
  staffSelect.addEventListener('change', checkBalance);
  typeSelect.addEventListener('change', checkBalance);
  // the popup closed another way (Esc, click outside) leaves a type with nothing left: ask again before saving
  form.addEventListener('submit', event => {
    const balance = currentBalance();
    if (balance !== null && balance <= 0) {
      event.preventDefault();
      askForLop();
    }
  });
  refreshBalance();

  const from = document.getElementById('leaveFrom');
  const to = document.getElementById('leaveTo');
  const days = document.getElementById('leaveDays');
  function updateDays(start, end, output) {
    if (!start.value || !end.value || end.value < start.value) {
      output.value = '';
      return;
    }
    const fromDate = new Date(`${start.value}T00:00:00Z`);
    const toDate = new Date(`${end.value}T00:00:00Z`);
    output.value = String(Math.floor((toDate - fromDate) / 86400000) + 1);
  }
  from.addEventListener('change', () => {
    to.min = from.value || from.min;
    if (to.value && to.value < to.min) to.value = to.min;
    updateDays(from, to, days);
  });
  to.addEventListener('change', () => updateDays(from, to, days));
  to.min = from.value || from.min;
  updateDays(from, to, days);
})();
</script>
}

@section Styles {
<style>
  .leave-entry-form { display: grid; gap: 16px; }
  .leave-entry-actions { display: flex; justify-content: flex-start; padding-top: 2px; }
  .leave-entry-actions .btn { min-width: 0; }
</style>
}
