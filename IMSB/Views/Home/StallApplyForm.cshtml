@model IMSB.Models.StallApplyFormViewModel
@{
    ViewData["Title"] = L["Stall application form"].Value;
    ViewData["FullWidth"] = true;

    var stepNames = new[] { L["SHG details"].Value, L["Representative"].Value, L["Products"].Value, L["Stall needs"].Value, L["Declaration"].Value, L["Review"].Value };
    // values stay in English (what the server accepts and stores); only the labels are translated
    var roles = IMSB.Dto.Models.ShgRepresentativeRoles.All;
    var durations = IMSB.Dto.Models.StallOptions.Durations;
    var facilities = IMSB.Dto.Models.StallOptions.Facilities;
    var maxYear = DateTime.Now.Year;
    // same range the server accepts (India time); month names follow the page's language
    var (firstMonth, lastMonth) = IMSB.Models.StallRequirementsInput.StartMonthRange(DateTime.UtcNow.AddHours(5.5));
    var firstName = firstMonth.ToString("MMMM yyyy");
    var lastName = lastMonth.ToString("MMMM yyyy");
    var optional = L["(optional)"];
    var saveAndContinue = L["Save and continue"];
    var back = L["Back"];
    var problem = L["There is a problem"];
}

<!-- Page head -->
<div class="page-head">
    <div class="container py-4 py-lg-5">
        <nav aria-label="@L["Breadcrumb"]">
            <ol class="breadcrumb mb-3">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@L["Home"]</a></li>
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="StallApply">@L["Apply for a Stall"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@L["Stall application form"]</li>
            </ol>
        </nav>
        <h1 class="display-5 fw-semibold section-title mb-2">@L["Stall application form"]</h1>
        <p class="lead text-body-secondary mb-2">@L["Apply for a stall at Indira Mahila Shakti Bazaar. It takes about 10 minutes."]</p>
        <p class="small text-body-secondary mb-0"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>@L["Last reviewed:"] @L["22 October 2026"]</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 g-lg-5" id="apply-layout">

        <!-- Stepper -->
        <div class="col-lg-3">
            <nav class="stepper sticky-lg-top" aria-label="@L["Application progress"]">
                <ol class="list-unstyled mb-0">
                    @for (var i = 0; i < stepNames.Length; i++)
                    {
                        <li data-for="@(i + 1)">
                            <span class="stepper-n" aria-hidden="true">@(i + 1)</span>
                            <span class="stepper-t">@stepNames[i]</span>
                        </li>
                    }
                </ol>
            </nav>
        </div>

        <!-- Form -->
        <div class="col-lg-9">
            <div class="alert alert-imsb d-flex gap-3 mb-4" role="note">
                <i class="bi bi-info-circle-fill fs-4 text-imsb-orange" aria-hidden="true"></i>
                <p class="mb-0">@H["<strong>Before you start:</strong> keep your SHG ID, VO and Mandal Samakhya names, and 1–5 product photos ready. All fields are required unless marked optional."]</p>
            </div>
            <noscript><div class="alert alert-warning">@L["This form needs JavaScript to check your answers step by step."]</div></noscript>

            <form id="stall-form" class="card border-0 shadow-sm" novalidate action="#"
                  data-save-shg-url="@Url.Action("SaveShgDetails", "Home")"
                  data-save-rep-url="@Url.Action("SaveRepresentative", "Home")"
                  data-save-product-url="@Url.Action("SaveProductDetails", "Home")"
                  data-save-stall-url="@Url.Action("SaveStallRequirements", "Home")"
                  data-save-declaration-url="@Url.Action("SaveDeclaration", "Home")"
                  data-submit-url="@Url.Action("SubmitApplication", "Home")">
                @Html.AntiForgeryToken()
                <input type="hidden" id="shg-public-id" name="shg-public-id" />
                <div class="card-body p-4 p-md-5">

                    <!-- ============ STEP 1 ============ -->
                    <section class="form-step" id="step-1" aria-labelledby="step-1-title">
                        <p class="step-count">@L["Step {0} of {1}", 1, 5]</p>
                        <h2 class="h3 section-title step-title" id="step-1-title" tabindex="-1">@L["SHG details"]</h2>
                        <p class="text-body-secondary mb-4">@L["Details of your Self-Help Group as in SERP records."]</p>
                        <div class="alert alert-danger error-summary" role="alert" tabindex="-1" hidden>
                            <h3 class="h6 fw-semibold">@problem</h3><ul class="mb-0"></ul>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="shg-name">@L["SHG name"]</label>
                                <input class="form-control" type="text" id="shg-name" name="shg-name" required data-msg="@L["Enter the name of your SHG"]" autocomplete="organization" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="shg-id">@L["SHG ID"]</label>
                                <input class="form-control" type="text" id="shg-id" name="shg-id" required aria-describedby="shg-id-hint" data-msg="@L["Enter your SHG ID"]"
                                       pattern="[A-Za-z0-9\/\-]{6,24}" data-msg-pattern="@L["Enter a valid SHG ID (6 to 24 letters, numbers, / or –)"]" autocapitalize="characters" spellcheck="false" />
                                <div class="form-text" id="shg-id-hint">@L["As shown on your SHG passbook or in SERP records. Letters, numbers, / or – only."]</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="vo-name">@L["Village Organisation (VO)"]</label>
                                <input class="form-control" type="text" id="vo-name" name="vo-name" required data-msg="@L["Enter the name of your Village Organisation"]" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ms-name">@L["Mandal Samakhya (MS)"]</label>
                                <input class="form-control" type="text" id="ms-name" name="ms-name" required data-msg="@L["Enter the name of your Mandal Samakhya"]" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="district">@L["District"]</label>
                                <select class="form-select" id="district" name="district" required data-msg="@L["Select your district"]">
                                    <option value="">@L["Select"]</option>
                                    @foreach (var d in Model.Districts) { <option value="@d.Id">@L[d.Name]</option> }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="mandal">@L["Mandal"]</label>
                                <input class="form-control" type="text" id="mandal" name="mandal" required data-msg="@L["Enter your mandal"]" aria-describedby="mandal-hint"
                                       maxlength="100" pattern="\p{L}[\p{L}\p{M}\p{Nd} .,'\(\)\-]*" data-msg-pattern="@L["Enter a valid mandal name"]" autocomplete="address-level3" />
                                <div class="form-text" id="mandal-hint">@L["For example: Pochampally."]</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="village">@L["Village or habitation"]</label>
                                <input class="form-control" type="text" id="village" name="village" required data-msg="@L["Enter your village or habitation"]" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="shg-year">@L["Year SHG was formed"] <span class="text-body-secondary">@optional</span></label>
                                <input class="form-control" type="number" id="shg-year" name="shg-year" min="1990" max="@maxYear" inputmode="numeric" data-msg-range="@L["Enter a year between {0} and {1}", 1990, maxYear]" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="shg-members">@L["Number of members"]</label>
                                <input class="form-control" type="number" id="shg-members" name="shg-members" required aria-describedby="shg-members-hint" data-msg="@L["Enter the number of members"]"
                                       min="5" max="25" inputmode="numeric" data-msg-range="@L["Enter a number between 5 and 25"]" />
                                <div class="form-text" id="shg-members-hint">@L["Usually 10 to 20 members."]</div>
                            </div>
                        </div>

                        <div class="form-nav">
                            <span></span>
                            <button type="button" class="btn btn-imsb btn-lg" data-step-next data-save="shg">
                                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true" data-saving></span>@saveAndContinue <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </button>
                        </div>
                    </section>

                    <!-- ============ STEP 2 ============ -->
                    <section class="form-step" id="step-2" aria-labelledby="step-2-title" hidden>
                        <p class="step-count">@L["Step {0} of {1}", 2, 5]</p>
                        <h2 class="h3 section-title step-title" id="step-2-title" tabindex="-1">@L["Representative and contact details"]</h2>
                        <p class="text-body-secondary mb-4">@L["The SHG member who will manage the stall and whom we can contact."]</p>
                        <div class="alert alert-danger error-summary" role="alert" tabindex="-1" hidden>
                            <h3 class="h6 fw-semibold">@problem</h3><ul class="mb-0"></ul>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="rep-name">@L["Full name"]</label>
                                <input class="form-control" type="text" id="rep-name" name="rep-name" required data-msg="@L["Enter the representative's full name"]" autocomplete="name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="rep-role">@L["Role in the SHG"]</label>
                                <select class="form-select" id="rep-role" name="rep-role" required data-msg="@L["Select the representative's role"]">
                                    <option value="">@L["Select"]</option>
                                    @foreach (var r in roles) { <option value="@r">@L[r]</option> }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="rep-age">@L["Age"]</label>
                                <input class="form-control" type="number" id="rep-age" name="rep-age" required data-msg="@L["Enter the representative's age"]" min="18" max="75" inputmode="numeric" data-msg-range="@L["Age must be between 18 and 75"]" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="rep-guardian">@L["Father's or husband's name"] <span class="text-body-secondary">@optional</span></label>
                                <input class="form-control" type="text" id="rep-guardian" name="rep-guardian" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="rep-mobile">@L["Mobile number"]</label>
                                <div class="input-group has-validation">
                                    <span class="input-group-text">+91</span>
                                    <input class="form-control" type="tel" id="rep-mobile" name="rep-mobile" required aria-describedby="rep-mobile-hint" data-msg="@L["Enter a mobile number"]" inputmode="numeric"
                                           maxlength="10" pattern="[6-9][0-9]{9}" data-msg-pattern="@L["Enter a 10-digit mobile number starting with 6, 7, 8 or 9"]" autocomplete="tel-national" />
                                </div>
                                <div class="form-text" id="rep-mobile-hint">@L["We will send application updates to this number."]</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="rep-mobile2">@L["Alternate mobile number"] <span class="text-body-secondary">@optional</span></label>
                                <div class="input-group has-validation">
                                    <span class="input-group-text">+91</span>
                                    <input class="form-control" type="tel" id="rep-mobile2" name="rep-mobile2" inputmode="numeric" maxlength="10" pattern="[6-9][0-9]{9}" data-msg-pattern="@L["Enter a 10-digit mobile number starting with 6, 7, 8 or 9"]" />
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="rep-email">@L["Email"] <span class="text-body-secondary">@optional</span></label>
                                <input class="form-control" type="email" id="rep-email" name="rep-email" autocomplete="email" data-msg-type="@L["Enter an email address like name@example.com"]" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="rep-address">@L["Address"]</label>
                                <textarea class="form-control" id="rep-address" name="rep-address" rows="3" required aria-describedby="rep-address-hint" data-msg="@L["Enter the address"]"></textarea>
                                <div class="form-text" id="rep-address-hint">@L["House number, street, village and mandal."]</div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <label class="form-label" for="rep-pin">@L["PIN code"]</label>
                                <input class="form-control" type="text" id="rep-pin" name="rep-pin" required data-msg="@L["Enter the PIN code"]" inputmode="numeric" maxlength="6"
                                       pattern="[1-9][0-9]{5}" data-msg-pattern="@L["Enter a 6-digit PIN code"]" autocomplete="postal-code" />
                            </div>
                        </div>

                        <div class="form-nav">
                            <button type="button" class="btn btn-outline-imsb btn-lg" data-step-back><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@back</button>
                            <button type="button" class="btn btn-imsb btn-lg" data-step-next data-save="rep">
                                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true" data-saving></span>@saveAndContinue <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </button>
                        </div>
                    </section>

                    <!-- ============ STEP 3 ============ -->
                    <section class="form-step" id="step-3" aria-labelledby="step-3-title" hidden>
                        <p class="step-count">@L["Step {0} of {1}", 3, 5]</p>
                        <h2 class="h3 section-title step-title" id="step-3-title" tabindex="-1">@L["Product details"]</h2>
                        <p class="text-body-secondary mb-4">@L["Tell us what your SHG makes. Good photos help the committee review your application."]</p>
                        <div class="alert alert-danger error-summary" role="alert" tabindex="-1" hidden>
                            <h3 class="h6 fw-semibold">@problem</h3><ul class="mb-0"></ul>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="prod-cat">@L["Product category"]</label>
                                <select class="form-select" id="prod-cat" name="prod-cat" required data-msg="@L["Select a product category"]">
                                    <option value="">@L["Select"]</option>
                                    @foreach (var c in Model.Categories) { <option value="@c.Id">@L[c.Name]</option> }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="prod-type">@L["Product type"]</label>
                                <input class="form-control" type="text" id="prod-type" name="prod-type" required aria-describedby="prod-type-hint" data-msg="@L["Enter the type of product"]" />
                                <div class="form-text" id="prod-type-hint">@L["For example: Pochampally ikat sarees, bamboo baskets, millet snacks."]</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="prod-desc">@L["Product description"]</label>
                                <textarea class="form-control" id="prod-desc" name="prod-desc" rows="4" required aria-describedby="prod-desc-hint" data-msg="@L["Describe your products"]"
                                          minlength="20" data-msg-short="@L["Write at least 20 characters about your products"]"></textarea>
                                <div class="form-text" id="prod-desc-hint">@L["Materials, how it is made, sizes or varieties. At least 20 characters."]</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="price-min">@L["Lowest price"]</label>
                                <div class="input-group has-validation">
                                    <span class="input-group-text">&#8377;</span>
                                    <input class="form-control" type="number" id="price-min" name="price-min" required data-msg="@L["Enter the lowest price"]" min="1" max="10000000" step="0.01" inputmode="decimal"
                                           data-msg-range="@L["Enter a price between ₹1 and ₹1,00,00,000"]" data-msg-step="@L["Enter the price in rupees and paise, like 250 or 250.50"]" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="price-max">@L["Highest price"]</label>
                                <div class="input-group has-validation">
                                    <span class="input-group-text">&#8377;</span>
                                    <input class="form-control" type="number" id="price-max" name="price-max" required data-msg="@L["Enter the highest price"]" min="1" max="10000000" step="0.01" inputmode="decimal"
                                           data-gte="price-min" data-msg-range="@L["Enter a price between ₹1 and ₹1,00,00,000"]" data-msg-step="@L["Enter the price in rupees and paise, like 250 or 250.50"]"
                                           data-msg-gte="@L["Highest price must be the same as or more than the lowest price"]" />
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="prod-capacity">@L["Monthly production capacity"] <span class="text-body-secondary">@optional</span></label>
                                <input class="form-control" type="text" id="prod-capacity" name="prod-capacity" aria-describedby="prod-capacity-hint" />
                                <div class="form-text" id="prod-capacity-hint">@L["For example: 40 sarees or 200 baskets a month."]</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="prod-images">@L["Product photos"]</label>
                                <input class="form-control" type="file" id="prod-images" name="prod-images" accept="image/jpeg,image/png" multiple required aria-describedby="prod-images-hint"
                                       data-msg="@L["Upload at least one product photo"]" data-max-files="5" data-max-mb="2" />
                                <div class="form-text" id="prod-images-hint">@L["Upload 1 to 5 clear photos of your products. JPG or PNG, up to 2 MB each."]</div>
                                <ul class="file-previews list-unstyled" id="prod-images-previews" aria-live="polite"></ul>
                            </div>
                        </div>

                        <div class="form-nav">
                            <button type="button" class="btn btn-outline-imsb btn-lg" data-step-back><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@back</button>
                            <button type="button" class="btn btn-imsb btn-lg" data-step-next data-save="product">
                                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true" data-saving></span>@saveAndContinue <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </button>
                        </div>
                    </section>

                    <!-- ============ STEP 4 ============ -->
                    <section class="form-step" id="step-4" aria-labelledby="step-4-title" hidden>
                        <p class="step-count">@L["Step {0} of {1}", 4, 5]</p>
                        <h2 class="h3 section-title step-title" id="step-4-title" tabindex="-1">@L["Stall requirements"]</h2>
                        <p class="text-body-secondary mb-4">@L["Your preferred stall period and the facilities you need."]</p>
                        <div class="alert alert-danger error-summary" role="alert" tabindex="-1" hidden>
                            <h3 class="h6 fw-semibold">@problem</h3><ul class="mb-0"></ul>
                        </div>

                        <div class="row g-4">
                            <fieldset class="col-12" id="stall-duration-group">
                                <legend class="form-label fs-6 fw-semibold">@L["How long do you want the stall?"]</legend>
                                <div class="d-flex flex-wrap gap-2">
                                    @for (var i = 0; i < durations.Length; i++)
                                    {
                                        <input type="radio" class="btn-check" id="stall-duration-@i" name="stall-duration" value="@durations[i]" autocomplete="off"
                                               required="@(i == 0)" data-msg="@(i == 0 ? L["Select how long you want the stall"].Value : null)" />
                                        <label class="btn btn-outline-secondary choice-btn" for="stall-duration-@i">@L[durations[i]]</label>
                                    }
                                </div>
                            </fieldset>
                            <div class="col-sm-6 col-md-5">
                                <label class="form-label" for="stall-start">@L["Preferred start month"]</label>
                                <input class="form-control" type="month" id="stall-start" name="stall-start" required aria-describedby="stall-start-hint" data-msg="@L["Select a preferred start month"]"
                                       min="@firstMonth.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)" max="@lastMonth.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)"
                                       data-msg-range="@L["Choose a month between {0} and {1}", firstName, lastName]" />
                                <div class="form-text" id="stall-start-hint">@L["From {0} to {1}. Allotment depends on availability.", firstName, lastName]</div>
                            </div>
                            <fieldset class="col-12">
                                <legend class="form-label fs-6 fw-semibold">@L["Facilities needed"] <span class="text-body-secondary fw-normal">@optional</span></legend>
                                <div class="row row-cols-1 row-cols-sm-2 g-2">
                                    @for (var i = 0; i < facilities.Length; i++)
                                    {
                                        <div class="col">
                                            <div class="form-check form-check-card">
                                                <input class="form-check-input" type="checkbox" id="stall-facilities-@i" name="stall-facilities" value="@facilities[i]" />
                                                <label class="form-check-label" for="stall-facilities-@i">@L[facilities[i]]</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </fieldset>
                            <fieldset class="col-12" id="prev-exhibit-group">
                                <legend class="form-label fs-6 fw-semibold">@L["Has your SHG sold at an exhibition or bazaar before?"]</legend>
                                <div class="d-flex flex-wrap gap-2">
                                    <input type="radio" class="btn-check" id="prev-exhibit-0" name="prev-exhibit" value="Yes" autocomplete="off" required data-msg="@L["Select yes or no"]" data-toggle-target="prev-exhibit-details" />
                                    <label class="btn btn-outline-secondary choice-btn" for="prev-exhibit-0">@L["Yes"]</label>
                                    <input type="radio" class="btn-check" id="prev-exhibit-1" name="prev-exhibit" value="No" autocomplete="off" data-toggle-target="prev-exhibit-details" />
                                    <label class="btn btn-outline-secondary choice-btn" for="prev-exhibit-1">@L["No"]</label>
                                </div>
                            </fieldset>
                            <div class="col-12" id="prev-exhibit-details" hidden>
                                <label class="form-label" for="prev-exhibit-text">@L["Which exhibitions, and when?"]</label>
                                <textarea class="form-control" id="prev-exhibit-text" name="prev-exhibit-text" rows="3" required data-msg="@L["Tell us which exhibitions you took part in"]"
                                          maxlength="1000"></textarea>
                            </div>
                        </div>

                        <div class="form-nav">
                            <button type="button" class="btn btn-outline-imsb btn-lg" data-step-back><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@back</button>
                            <button type="button" class="btn btn-imsb btn-lg" data-step-next data-save="stall">
                                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true" data-saving></span>@saveAndContinue <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </button>
                        </div>
                    </section>

                    <!-- ============ STEP 5 ============ -->
                    <section class="form-step" id="step-5" aria-labelledby="step-5-title" hidden>
                        <p class="step-count">@L["Step {0} of {1}", 5, 5]</p>
                        <h2 class="h3 section-title step-title" id="step-5-title" tabindex="-1">@L["Documents and declaration"]</h2>
                        <p class="text-body-secondary mb-4">@L["Upload supporting documents if you have them, and confirm the declaration."]</p>
                        <div class="alert alert-danger error-summary" role="alert" tabindex="-1" hidden>
                            <h3 class="h6 fw-semibold">@problem</h3><ul class="mb-0"></ul>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="doc-shg">@L["SHG passbook first page or SHG certificate"] <span class="text-body-secondary">@optional</span></label>
                                <input class="form-control" type="file" id="doc-shg" name="doc-shg" accept="image/jpeg,image/png,application/pdf" aria-describedby="doc-shg-hint" data-max-files="1" data-max-mb="2" />
                                <div class="form-text" id="doc-shg-hint">@L["JPG, PNG or PDF, up to 2 MB."]</div>
                                <ul class="file-previews list-unstyled" id="doc-shg-previews" aria-live="polite"></ul>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="doc-id">@L["Representative's identity proof"] <span class="text-body-secondary">@optional</span></label>
                                <input class="form-control" type="file" id="doc-id" name="doc-id" accept="image/jpeg,image/png,application/pdf" aria-describedby="doc-id-hint" data-max-files="1" data-max-mb="2" />
                                <div class="form-text" id="doc-id-hint">@L["Voter ID, ration card or any government photo ID. Please cover any Aadhaar number before uploading. JPG, PNG or PDF, up to 2 MB."]</div>
                                <ul class="file-previews list-unstyled" id="doc-id-previews" aria-live="polite"></ul>
                            </div>
                            <div class="col-12 mt-4">
                                <div class="form-check form-check-card">
                                    <input class="form-check-input" type="checkbox" id="decl-true" name="decl-true" value="true" required data-msg="@L["Confirm that the details are true"]" />
                                    <label class="form-check-label" for="decl-true">@L["I confirm that the details given are true and that the products are made by members of our SHG."]</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-check-card">
                                    <input class="form-check-input" type="checkbox" id="decl-consent" name="decl-consent" value="true" required data-msg="@L["Agree to the use of these details for your application"]" />
                                    <label class="form-check-label" for="decl-consent">@H["I agree that SERP and IMSB may use these details to review this application and contact us about it. See the <a href=\"{0}\" target=\"_blank\">privacy policy</a>.", Url.Action("Privacy", "Home")!]</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-nav">
                            <button type="button" class="btn btn-outline-imsb btn-lg" data-step-back><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@back</button>
                            <button type="button" class="btn btn-imsb btn-lg" data-step-next data-save="declaration">
                                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true" data-saving></span>@L["Save and review"] <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </button>
                        </div>
                    </section>

                    <!-- ============ REVIEW ============ -->
                    <section class="form-step" id="step-review" aria-labelledby="step-review-title" hidden>
                        <h2 class="h3 section-title step-title" id="step-review-title" tabindex="-1">@L["Check your application"]</h2>
                        <p class="text-body-secondary mb-4">@H["Check the details below. Use <strong>Change</strong> to correct anything, then select <strong>Save and continue</strong> on each step to come back here."]</p>
                        <div class="alert alert-danger error-summary" role="alert" tabindex="-1" hidden>
                            <h3 class="h6 fw-semibold">@problem</h3><ul class="mb-0"></ul>
                        </div>
                        <div class="d-grid gap-3" id="review"></div>
                        <div class="form-nav">
                            <button type="button" class="btn btn-outline-imsb btn-lg" data-step-back><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@back</button>
                            <button type="submit" class="btn btn-imsb btn-lg">
                                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true" data-saving></span><i class="bi bi-send me-1" aria-hidden="true"></i>@L["Submit application"]
                            </button>
                        </div>
                        <p class="small text-body-secondary mt-3 mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@L["After you submit, the application can no longer be changed."]</p>
                    </section>
                </div>
            </form>

            <!-- ============ DONE ============ -->
            <section class="card border-0 shadow-sm text-center form-done" id="form-done" hidden aria-labelledby="done-title">
                <div class="card-body p-4 p-md-5">
                    <div class="done-badge mx-auto mb-3" aria-hidden="true"><i class="bi bi-check-lg"></i></div>
                    <h2 id="done-title" class="h3 section-title" tabindex="-1">@L["Application submitted"]</h2>
                    <p class="fs-5">@L["Your reference number:"] <strong id="done-ref"></strong></p>
                    <p class="text-body-secondary mx-auto" style="max-width: 36rem;">@H["Your application has been sent to the IMSB allotment committee for review. Keep this reference number. We will contact you on <strong id=\"done-mobile\"></strong> about your application."]</p>
                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4 d-print-none">
                        <button type="button" class="btn btn-outline-imsb btn-lg" data-print><i class="bi bi-printer me-1" aria-hidden="true"></i>@L["Print a copy"]</button>
                        <a class="btn btn-imsb btn-lg" asp-controller="Home" asp-action="Index">@L["Back to home"]</a>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/stall-form.js" asp-append-version="true"></script>
}
