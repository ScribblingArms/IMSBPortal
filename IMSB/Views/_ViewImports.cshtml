@using IMSB
@using IMSB.Models
@using Microsoft.AspNetCore.Mvc.Localization
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* L: plain text in the visitor's language; H: text that carries markup (<strong>, links). The English text is the key. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject IHtmlLocalizer<SharedResource> H
